def Infantry
{
	delete counter
	delete countered
	counter = []
	countered = ["HeavyCavalry","Ranged","HeavyRanged","RangedCavalry","HeavyRangedCavalry"]
}

def HeavyInfantry
{
	delete counter
	delete countered
	counter = ["Infantry","Defense"]
	countered = ["HeavyCavalry","HeavyRanged"]
}

def Defense
{
	delete counter
	delete countered
	counter = ["Cavalry"]
	countered = ["HeavyInfantry"]
}

def HeavyDefense
{
	delete counter
	delete countered
	counter = ["Cavalry","HeavyCavalry"]
	countered = ["HeavyInfantry","HeavyRanged"]
}

def Cavalry
{
	delete counter
	delete countered
	counter = ["Ranged"]
	countered = ["Defense","HeavyCavalry"]
}

def HeavyCavalry
{
	delete counter
	delete countered
	counter = ["Infantry","HeavyInfantry","Cavalry","Ranged","HeavyRanged"]
	countered = ["HeavyDefense"]
}

def Ranged
{
	delete counter
	delete countered
	counter = ["Infantry","RangedCavalry"]
	countered = ["Cavalry","HeavyCavalry","HeavyRangedCavalry"]
}

def HeavyRanged
{
	delete counter
	delete countered
	counter = ["Infantry","HeavyInfantry","HeavyDefense","RangedCavalry","HeavyRangedCavalry"]
	countered = ["HeavyCavalry"]
}

def RangedCavalry
{
	delete counter
	delete countered
	counter = ["Infantry"]
	countered = ["Ranged","HeavyRanged"]
}

def HeavyRangedCavalry
{
	delete counter
	delete countered
	counter = ["Infantry","Ranged"]
	countered = ["HeavyRanged"]
}



