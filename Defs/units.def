def Battering_Ram : SiegeEquipment
{
	//csv://csv: name = "Battering Ram"
	description = "Warmachine, created to take down castle gates."
	model = "Assets/Units/BV_Ram/BV_Ram.prefab" //GUID:80c841c513f833c4ea25283b8ce14c26
	available = true
	selection_radius = 1.5
	radius = 4
	turn_speed = 45
	siege_damage = 3
	max_health = 6
	hire_sound = "event:/sound_effects/interaction/siege/battering_ram"
	select_sound = "event:/sound_effects/interaction/siege/battering_ram"
	hire_failed_sound = "event:/sound_effects/interaction/unavailable"
	dying_sound = "event:/sound_effects/battleview/siege_equipment/destroyed/battering_ram"
	marching_sound = "event:/sound_effects/battleview/siege_equipment/moving/batteing_ram"
	running_sound = marching_sound
	sprinting_sound = marching_sound
	charging_sound = marching_sound
	
	counter = ["Gate"]
	countered = ["Heavy_Trebuchet"]

    require
	{
        Workshop
		Craftsmen
	}
	
	icon = "Assets/UI/Elements/Common/Icons/Units/Icon_InvetoryItem_BatteringRam.png:Icon_InvetoryItem_BatteringRam#1" //GUID:d96e15c9cc15fe04f8232c46aa5cfd53
	float attack_frame_anim_time = 1.17
	
	hit_wood_gate_sound = "event:/sound_effects/battleview/gate/hit/wooden"
	hit_metal_gate_sound = "event:/sound_effects/battleview/gate/hit/metal"
	
	can_attack_gates = true
	can_attack_melee = false

	hide_in_wiki = false
}

