def Army
{
	max_units = 8
	{
		int marshal = 8
		int shaman = 8
		int crusader = 8
		int king = 8
	}

	int max_inventory = 2
	{
		marshal = 3
		king = 3
	}
	water_enter_duration = 10
	water_exit_duration = 10
	supplies_consumption_interval = 5

	supplies_consumption = 1
	{
		//Kingdom stances
		War = 1
		Peace = 1
		NonAggression = 0.5
		Alliance = 0.5
		Vassalage = 0.5
		Own = 0.2
		Sailing = 1
		
		//       Modifiers
		NeighbouringProvinceMod = 0.75
		
		//Battles
		OpenField = 1
		Plunder = 1
		Siege = 1
		Assault = 1
		BreakSiege = 1
		Naval = 1
		
		//Other
		Camping = 0.75
		Disorganized = 1
		OwnTown = 0
	}
}

