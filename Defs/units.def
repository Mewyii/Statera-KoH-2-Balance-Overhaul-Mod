def Heavy_Trebuchet : SiegeEquipment
{
	//csv://csv: name = "Trebuchet"
	description = "Warmachine, created to take down castle walls and devastate all structures and men in the way of its projectiles."
	model = "Assets/Units/BV_Trebuchet_01/BV_Trebuchet_01.prefab" //GUID:9fbb64ef8cbe99e428139d47c62df98d
	squad_banner = "Assets/Units/BV_Trebuchet_01/squad_banner_trebuchet.prefab" //GUID:a30f5a28240d54c4eb9b1483c95a6b80
	squad_icon = "Assets/Units/BV_Trebuchet_01/squad_icon trebuchet.prefab" //GUID:1fe88756a0339dc48ac0c442bc2fed9e
	hire_sound = "event:/sound_effects/interaction/siege/trebuchet"
	select_sound = "event:/sound_effects/interaction/siege/trebuchet"
	hire_failed_sound = "event:/sound_effects/interaction/unavailable"
	packing_sound = "event:/sound_effects/battleview/siege_equipment/unpacking/trebuchet" //sound effect not ready
	dying_sound = "event:/sound_effects/battleview/siege_equipment/destroyed/trebuchet"
	marching_sound = "event:/sound_effects/battleview/siege_equipment/moving/trebuchet"
	running_sound = marching_sound
	sprinting_sound = marching_sound
	charging_sound = marching_sound
	VO_role = null
	
	counter = ["WallsAndTowers","Catapult","Battering_Ram","Heavy_Siege_Ram"]
	countered = ["Heavy_Trebuchet"]
	
	walk_anim_speed = 0
	
	available = true
	selection_radius = 1.8
	turn_speed = 45
	siege_damage = 7
	max_health = 10
	
	secondary_type = "Ranged"
	
	require
	{
        SiegeWorkshop
		TrebuchetAssemblyYard
	}
	icon = "Assets/UI/Elements/Common/Icons/Units/Icon_InvetoryItem_Trebuchet.png:Icon_InvetoryItem_Trebuchet#2" //GUID:bfe320789668afc4c80cb8355db68093
	
	float attack_frame_anim_time = 0.25
	auto_find_target = true
	can_attack_gates = true
	can_attack_walls = true
	can_attack_towers = true
	can_attack_melee = false
	max_random_shoot_offset = 15
	
	string packed_def_key = "TrebuchetPacked"
	float unpack_time = 10
	prefab unpack_particles = "Assets/BattleView/BV_FX/SiegeEquipmentPackDust.prefab" //GUID:50d9951f19e09a64d85feddf7bfc56e5
	radius = 6.8
	battle_scale = 0.8
	
	float terrain_normal_points = [
	0, 1,
	1, 0,
	-1, 0,
	0, -1
	]

	hide_in_wiki = false
}

