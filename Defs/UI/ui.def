def BuildWindowSettings : UIWindow
{
	relation_highlights
	{
		color none = white
		color this = yellow
		color selected = "e5b615"
		color requires = "102, 255, 94"
		color requires_indirect = "102, 209, 96"
		color enables = "255, 79, 79"
		color enables_indirect = "196, 79, 79"
		color will_be_destroyed = red
	}
}


def BuildingSlot : UIComponent
{
	window_prefab = "Assets/UI/Settlements/UIP_BuildingSlot.prefab" //GUID:fab752e68a370ba4ba283188dc63f84f
	casle_slot_empty
	{
		sprite normal = "Assets/UI/Elements/BuildingSlots/Building/Empty_Slot_Buildings.png:Empty_Slot_Buildings#1" //GUID:1c312d6061a03704da2c6fdd25888cf1
