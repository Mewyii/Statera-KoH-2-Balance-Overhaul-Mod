Building.slots_base = 6
Building.slots_expand_cost.gold = (500 + 500 * (realm_tier))

extend FlaxGrowing 
{
    delete Requires
}

extend HerbGardening 
{
    delete Requires
}

def Church : Building
{
	delete upgrades
	upgrades
	{
		buildings
		{
			PriestlyEducation = 1,1
			FestiveCalendar = 2,1
			Cemetries = 3,1

			Processions = 1,2 { prerequisites { PriestlyEducation } }
			ProperBells = 2,2 { prerequisites { FestiveCalendar } }

			MonasticSchooling = 1,3 { prerequisites { Processions } }
		}
	}

	icon = "Assets/Icons/Buildings/Church.png:Church#1"
	illustration = "Assets/Icons/Buildings/Church.png:Church#1"
}

def CityMonastery : Building
{
	name = "Monastery"
	flavor = "A secluded religious community devoted to prayer, study, and labor, forming a cornerstone of faith and learning across Christendom."
	piety_type = "Christian"
	upgrades
	{
		buildings
		{
			HerbGrowing = 1,1
			Scriptorium = 2,1
			Hospitium = 3,1

			Hospital = 1,2 { prerequisites { HerbGrowing } }
			IlluminatorsAtelier = 2,2 { prerequisites { Scriptorium } }
			CistercianDiscipline = 3,2 { prerequisites { Hospitium } }
		}
	}
	icon = "Assets/Icons/Buildings/Monastery.png:Monastery#1"
	illustration = "Assets/Icons/Buildings/Monastery.png:Monastery#1"
}

