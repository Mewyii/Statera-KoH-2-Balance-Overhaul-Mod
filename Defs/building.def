delete Harbor
def Harbor : Building
{
	name = "Harbor"
	flavor = "A sheltered waterfront where ships anchor safely, serving as the gateway between the city and the open sea."

	upgrades
	{
		buildings
		{
			Warehouse_Harbor = 1,1
			Boatwright_Harbor = 1,2
			HarborChains = 2,1
			BeaconTowers = 2,2
		}
	}

	icon = "Assets/Icons/Buildings/Harbor.png:Harbor#1"
	illustration = "Assets/Icons/Buildings/Harbor.png:Harbor#1"
}

def FishingDocks : Building
{
	name = "Fishing Docks"
	flavor = "Simple piers and sheds dedicated to fishing vessels, supplying the city with fresh catch and maritime livelihoods."

	icon = "Assets/Icons/Buildings/FishingDocks.png:FishingDocks#1"
	illustration = "Assets/Icons/Buildings/FishingDocks.png:FishingDocks#1"
}

def Shipyard : Building
{
	flavor = "A coastal workshop where ships are built, repaired, and refitted, combining timber, iron, and skilled labor into seaworthy vessels."
    
	icon = "Assets/Icons/Buildings/Shipyard.png:Shipyard#1"
	illustration = "Assets/Icons/Buildings/Shipyard.png:Shipyard#1"
}

def TradePort : Building
{
	flavor = "An expanded harbor complex handling large volumes of cargo, customs duties, and long-distance maritime commerce."
    
	icon = "Assets/Icons/Buildings/TradePort.png:TradePort#1"
	illustration = "Assets/Icons/Buildings/TradePort.png:TradePort#1"
}

// Crafting

def Workshop : Building
{
	name = "Workshop"
	flavor = "A communal workspace where skilled artisans produce tools, furnishings, and construction materials vital to urban growth."

	upgrades
	{
		buildings
		{
			Toolmaking = 1,1
			Craftsmenship = 2,1
			Stonemasonry = 3,1
		}
	}

	icon = "Assets/Icons/Buildings/Workshop.png:Workshop#1"
	illustration = "Assets/Icons/Buildings/Workshop.png:Workshop#1"

	ai_eval = (base_ai_eval + (!kingdom.Workshop and 10000))
	ai_urgent = (!kingdom.Workshop)
}

def Blacksmith : Building
{
	name = "Blacksmith"
	flavor = "The forge and anvil form the beating heart of any settlement, where iron is shaped into tools, weapons, and armor."

	upgrades
	{
		buildings
		{
			SimpleWeaponsmithing = 1,1
			SimpleArmorsmithing = 2,1

			ForgeBellows = 1,2
			Toolsmithing = 2,2 { prerequisites { ForgeBellows } }

    		AdvancedWeaponsmithing = 1,3 { prerequisites { Toolsmithing; SimpleWeaponsmithing } }
    		AdvancedArmorsmithing = 2,3 { prerequisites { Toolsmithing; SimpleArmorsmithing } }
		}
	}

	icon = "Assets/Icons/Buildings/Blacksmith.png:Blacksmith#1"
	illustration = "Assets/Icons/Buildings/Blacksmith.png:Blacksmith#1"

	ai_eval = ((castle.TrainingField or 0) * ((castle.ArmyStables or castle.CityWatch) or 0.66) * ((base_ai_eval + max(0, (kingdom.realms_count + 4 / 5) - (kingdom.Blacksmith or 0)) * 2500)))
	ai_category = "Military"
}

def Tanneries : Building
{
	name = "Tannery"
	flavor = "Workshops where animal hides are processed into durable leather for armor, clothing, and trade goods."

	upgrades
	{
		buildings
		{
			ImprovedTanningLiquors = 1,1
			Leatherworking = 1,2 { prerequisites { ImprovedTanningLiquors } }
		}
	}

	icon = "Assets/Icons/Buildings/Tannery.png:Tannery#1"
	illustration = "Assets/Icons/Buildings/Tannery.png:Tannery#1"

	ai_eval = (base_ai_eval + (!kingdom.Tanneries and 1000))
}

