def TrainingField : Building
{
	name = "Training Field"
	flavor = "A field set aside for training militias and knights, instilling discipline and martial skill in local levies."
	add_tooltip = "{blt} Required for recruiting {clr:enables_color}light units{/clr}"
	upgrades
	{
		buildings
		{
			ArcheryRange = 1,1
			MilitiaDrills = 2,1
			KnightlyTrainingGrounds = 3,1
		}
	}
	icon = "Assets/Icons/Buildings/TrainingField.png:TrainingField#1"
	illustration = "Assets/Icons/Buildings/TrainingField.png:TrainingField#1"

	ai_category = "Military"
	ai_eval = (10000 + max(0, min(4, kingdom.realms_count / 2) - (kingdom.Barracks or 0)) * 50000)
}

