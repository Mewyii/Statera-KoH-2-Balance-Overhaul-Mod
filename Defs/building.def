extend Building
{
	slots_base = 7
	slots_expand_cost.gold = (250 + 250 * (realm_tier))

	float base_ai_eval = 250
	ai_eval = base_ai_eval
}

def Church : Building
{
	delete upgrades
	upgrades
	{
		buildings
		{
			PriestlyEducation = 1,1
			FestiveCalendar = 2,1
			Cemetries = 3,1

			Processions = 1,2 { prerequisites { PriestlyEducation } }
			ProperBells = 2,2 { prerequisites { FestiveCalendar } }
		}
	}

	icon = "Assets/Icons/Buildings/Church.png:Church#1"
	illustration = "Assets/Icons/Buildings/Church.png:Church#1"
}

def CityMonastery : Building
{
	name = "Monastery"
	flavor = "A secluded religious community devoted to prayer, study, and labor, forming a cornerstone of faith and learning across Christendom."
	piety_type = "Christian"
	upgrades
	{
		buildings
		{
			HerbGrowing = 1,1
			Scriptorium = 2,1
			CistercianDiscipline = 3,1

			Hospital = 1,2 { prerequisites { HerbGrowing } }
			ScholaMonastica = 2,2 { prerequisites { Scriptorium } }
			IlluminatorsAtelier = 3,2 { prerequisites { Scriptorium } }
		}
	}
	icon = "Assets/Icons/Buildings/Monastery.png:Monastery#1"
	illustration = "Assets/Icons/Buildings/Monastery.png:Monastery#1"

	ai_eval = (base_ai_eval + 250 + (!kingdom.CityMonastery and 1500))
}

def Cathedral : Building
{
	flavor = "A monumental house of worship and civic pride, embodying divine authority and the pinnacle of medieval craftsmanship."
	 delete upgrades
	 upgrades
	 {
	 	buildings
	 	{
			ChristianCeremonies = 1,1
	 		StainedGlassWorkshops = 2,1
	 		Cloister = 3,1

	 		ChoralLiturgy = 1,2 { prerequisites { ChristianCeremonies } }
	 		GothicTechniques = 2,2 { prerequisites { StainedGlassWorkshops } }
	 	}
	 }
	icon = "Assets/Icons/Buildings/Cathedral.png:Cathedral#1"
	illustration = "Assets/Icons/Buildings/Cathedral.png:Cathedral#1"
}

