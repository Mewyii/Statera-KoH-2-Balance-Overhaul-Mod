// Farming

def CropFarming : Building
{
	delete upgrades
	upgrades
	{
		buildings
		{
			HorseHarnessing = 1,1
			Granary = 2,1
			FlaxFarming = 3,1

			HeavyPloughsWorkshop = 1,2 { prerequisites { HorseHarnessing } }
			DryingOvens = 2,2 { prerequisites { Granary } }

			CropsRotation = 1,3 { prerequisites { HeavyPloughsWorkshop } }
		}
	}

	icon = "Assets/Icons/Buildings/CropFarming.png:CropFarming#1"
	illustration = "Assets/Icons/Buildings/CropFarming.png:CropFarming#1"
}

def WeavingMill : Building
{
	name = "Weaving Mill"
	flavor = "Workshops where fibers from flax or wool are processed into cloth, forming the heart of the textile economy."

	upgrades
	{
		buildings
		{
			SpinningWheels = 1,1
			FullingMills = 2,1
			CanvasMaker = 3,1
			ClothManufacturing = 1,2 { prerequisites { SpinningWheels } }
			ArmorWeaving = 2,2 { prerequisites { SpinningWheels; FullingMills } }
		}
	}
	
	icon = "Assets/Icons/Buildings/WeavingMill.png:WeavingMill#1"
	illustration = "Assets/Icons/Buildings/WeavingMill.png:WeavingMill#1"

	ai_eval = (base_ai_eval + 500)
}

def Windmill : Building
{
	flavor = "Centers of early mechanization, where grain and raw materials are processed using the steady force of water or wind."
	delete upgrades
	upgrades
	{
		buildings
		{
			Bakery = 1,1
			Breweries = 2,1
			OilPress = 3,1
		}
	}

	icon = "Assets/Icons/Buildings/Windmill.png:Windmill#1"
	illustration = "Assets/Icons/Buildings/Windmill.png:Windmill#1"
}
// River

def RiverDocks : Building
{
	name = "River Docks"
	flavor = "Wooden piers and quays lining the riverbank, enabling the steady movement of goods, people, and supplies along inland waterways."

    upgrades
	{
		buildings
		{
			AnglersHuts = 1,1
			Warehouse_RiverTrade = 1,2
			Boatwright = 1, 3
		}
	}

	icon = "Assets/Icons/Buildings/RiverDocks.png:RiverDocks#1"
	illustration = "Assets/Icons/Buildings/RiverDocks.png:RiverDocks#1"
}

def Irrigation : Building
{
	name = "Irrigation"
	flavor = "A system of canals, redirecting water from the rivers to agricultural lands near by. In result the yield is substantially increased."

	upgrades
	{
		buildings
		{
			WaterWheels = 1,1
		}
	}

	icon = "Assets/Icons/Buildings/Irrigation.png:Irrigation#1"
	illustration = "Assets/Icons/Buildings/Irrigation.png:Irrigation#1"
}

