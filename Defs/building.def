// Christian Buildings
// Religious

def Church : Building
{
	delete upgrades
	upgrades
	{
		buildings
		{
			PriestlyEducation = 1,1
			FestiveCalendar = 2,1
			Cemetries = 3,1

			Processions = 1,2 { prerequisites { PriestlyEducation } }
			ProperBells = 2,2 { prerequisites { FestiveCalendar } }
		}
	}

	icon = "Assets/Icons/Buildings/Church.png:Church#1"
	illustration = "Assets/Icons/Buildings/Church.png:Church#1"
}

def CityMonastery : Building
{
	name = "Monastery"
	flavor = "A secluded religious community devoted to prayer, study, and labor, forming a cornerstone of faith and learning across Christendom."
	piety_type = "Christian"
	upgrades
	{
		buildings
		{
			HerbGrowing = 1,1
			Scriptorium = 2,1
			CistercianDiscipline = 3,1

			Hospital = 1,2 { prerequisites { HerbGrowing } }
			ScholaMonastica = 2,2 { prerequisites { Scriptorium } }
