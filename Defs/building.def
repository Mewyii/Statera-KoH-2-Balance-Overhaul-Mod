	illustration = "Assets/Icons/Buildings/Stables.png:Stables#1"

	ai_category = "Military"
	ai_eval = (10000 + max(0, min(4, kingdom.realms_count / 2) - (kingdom.Barracks or 0)) * 50000)
}

