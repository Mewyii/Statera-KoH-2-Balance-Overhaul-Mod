// Common Buildings
// Military

def TrainingField : Building
{
	name = "Training Field"
	flavor = "A field set aside for training peasants and knights, instilling discipline and martial skill in local levies."
	add_tooltip = "{blt} Required for recruiting {clr:enables_color}trained levy units{/clr}"

	upgrades
	{
		buildings
		{
			MilitiaDrills = 1,1
			ArcheryRange = 2,1
			KnightlyTrainingGrounds = 3,1
		}
	}
	
	icon = "Assets/Icons/Buildings/TrainingField.png:TrainingField#1"
	illustration = "Assets/Icons/Buildings/TrainingField.png:TrainingField#1"

	ai_category = "Military"
	ai_eval = (500 + max(0, ((kingdom.realms_count + 2) / 3) - (kingdom.TrainingField or 0)) * 5000)
	ai_urgent = (!kingdom.TrainingField)
}

def ArmyStables : Building
{
	type = "Building"

	name = "Stables"
	flavor = "Essential facilities for breeding, housing, and maintaining the horses that serve both farm and battlefield."
	add_tooltip = "{blt} Required for recruiting {clr:enables_color}cavalry units{/clr}"

	upgrades
	{
		buildings
		{
			MessengerService = 1,1
			KnightlyStables = 2,1
			Farrier = 3,1
		}
	}
	
	icon = "Assets/Icons/Buildings/Stables.png:Stables#1"
	illustration = "Assets/Icons/Buildings/Stables.png:Stables#1"

	ai_category = "Military"
	ai_eval = ((castle.TrainingField or 0.5) * (castle.Blacksmith or 0.5) * ((base_ai_eval + max(0, (kingdom.realms_count + 4 / 5) - (kingdom.ArmyStables or 0)) * 2000)))
}

def CityWatch : Building
{
	name = "City Watch"
	flavor = "An organized guard force tasked with maintaining order, patrolling walls, and responding to threats within the city."

	upgrades
	{
		buildings
		{
			MilitiaBarracks = 1,1
			AlarmBells = 2,1
			MercenaryHiringOffice = 3,1

			CrossbowManufactoring = 1,2
			WatchRotations = 2,2
		}
	}
	
	icon = "Assets/Icons/Buildings/CityWatch.png:CityWatch#1"
	illustration = "Assets/Icons/Buildings/CityWatch.png:CityWatch#1"

	ai_category = "Military"
	ai_eval = ((castle.worker_slots > 10) or 0.25) * (500 + (max(0, (kingdom.realms_count + 4 / 5) - (kingdom.CityWatch or 0)) * 5000))
}

def ArmySiegeWorkshop : Building
{
	name = "Siege Workshop"
	flavor = "A specialized complex where engineers and craftsmen design, build, and maintain engines of war for siege and defense."
	add_tooltip = "{blt} Enables constructing {clr:enables_color}siege equipment{/clr}"

	upgrades
	{
		buildings
		{
			TrebuchetAssemblyYard = 1,1
			GunpowderStorage = 2,1

			CannonFoundry = 2,2 { prerequisites { GunpowderStorage } }
		}
	}
	
	icon = "Assets/Icons/Buildings/SiegeWorkshop.png:SiegeWorkshop#1"
	illustration = "Assets/Icons/Buildings/SiegeWorkshop.png:SiegeWorkshop#1"
	
	ai_category = "Military"
	ai_eval = (!kingdom.ArmySiegeWorkshop and kingdom.Blacksmith and 2000)
}

def Armory: Building {
	name = "Armory"
	flavor = "Central storage and workshop where weapons, armor, and supplies are crafted, repaired, and distributed to troops."

	upgrades
	{
		buildings
		{
			RecruitmentOffices = 1,1
			HeraldryChambers = 2,1
			PlanningRoom = 3,1
		}
	}
	
	icon = "Assets/Icons/Buildings/Armory.png:Armory#1"
	illustration = "Assets/Icons/Buildings/Armory.png:Armory#1"
	
	ai_category = "Military"
	ai_eval = (base_ai_eval + 500)
}

