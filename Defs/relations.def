extend FadingRelModifier
{
	stat = "relations"
	float perm_value
	peak = 0.5
	value = (perm_value * peak)
	duration = 300
	fade_out_time = 600
}

extend RelationUtils
{
	//tresholds for: Hostile, Negative, Reserved, Neutral, Sympathetic, Trusting, Friendly
	float relationship_thresholds = [-1000, -500, -250, -100, 100, 250, 500, 1000]

	def InitialRelationship
	{
		// If-Conditions work here, but sadly kingdom, src_kingdom or own_kingdom dont work so no possibility so set initial relations historically accurate.
		float negative_factor = (0)
		float positive_factor = (0)
		rnd_min = (clamp((-350 + positive_factor - negative_factor), -1000, 1000))
		rnd_max = (clamp((150 + positive_factor - negative_factor), -1000, 1000))
		no_relations_distance = 3 //on this distance and above, rel is 0
		not_neighbour_modifier = 0.5
		war_threshold = -340
		chance_join_existing_war = 10
		trade_thresold = -50 //minimum relationship for trade agreements at the start of the game (-1000 to turn this check off)
		trades_base = 1 // num of initial trades = base + num_provinces/provinces_per_trade
		provinces_per_trade = 3
		trades_max_distance = 2 //kingdom-kingdom distance in realms
		marriage_bonus = 300
	}

	fade_settings
	{
		fade_temp_per_sec = 0.2
		fade_far_per_sec = 0.05  

		fade_on_new_king_near = 0.15
		fade_on_new_king_far = 0.3
	}
}

extend RelationModifiers
{
	// First is a a permanent relation change, second one fades after time. Both are immediate.
	rel_mod rel_sign_peace = [(250 - (100 * tgt_kingdom.is_player)), 50, (1 * !leader_signed_peace)]
	rel_mod rel_decline = [(-10 - (10 * tgt_kingdom.is_player)), (-10 - (10 * tgt_kingdom.is_player)), 0]
}