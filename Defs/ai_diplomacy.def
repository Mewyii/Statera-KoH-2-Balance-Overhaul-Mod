delete PC_SignNonAggression
def PC_SignNonAggression : ProsAndCons
{
	cost = (1500 + (min((our_kingdom.num_realms + our_kingdom.num_vassals), 10) * 400))
	
	float desired_naps_multiplier = (max(our_kingdom.num_realms - (our_kingdom.non_aggressions_count * 5), 0))
	float desired_naps_value = (min((desired_naps_multiplier * 20), 20))

	pros = (10 + desired_naps_value + ((our_kingdom.num_realms / our_kingdom.num_marshals) * 0.5) + (our_kingdom.num_disorder_realms * 5))
	{
		pc_we_have_good_relation { base = 3; max = 30; pow = 0.5 }
		pc_we_have_too_many_wars { max = 25; at_war_base = 5; per_additional_war = 15 }
		pc_our_trade_level { max = 20 }
	  	pc_we_have_war_exhaustion { max = 25; pow = 1.25 }
		pc_we_have_rebels {	max = 10; per_rebel = 4 }
	  	pc_we_have_common_enemies {	max = 15; per_enemy = 10 }
		pc_their_trade_level { max = 10 }
		pc_they_are_X_times_larger = 10 { X = 1.75 ; added_realms = 3 }
	}

	cons = 40
	{
		pc_we_have_no_border = 50
		pc_they_rule_our_people { our_kingdom = 10; our_culture = 5; our_culture_family = 2; max = 30 }
		pc_they_rule_our_lands { per_historical_realm = 5; per_core_realm = 5;	max = 30 }
		pc_we_have_bad_relation	{ max = 15;	pow = 2 }
		pc_they_fight_our_friends { max = 15; per_kingdom = 7; threshold = 250 }
		pc_our_king_is_venerable = 15
		pc_their_king_is_venerable = 15
		pc_we_just_had_peace = 10 { minutes = 10}
		pc_our_king_is_old = 5
		pc_their_king_is_old = 5
		pc_there_are_our_loyalists = 5
		pc_our_army_is_stronger = 5
		pc_they_are_player_by_difficulty
		{
			easy = 0
			normal = 0
			hard = 8
			very_hard = 15
		}
	}

	thresholds
	{
		propose = 1.2
		accept = 1
	}

	relationship_scale
	{
		PP = 0.8 / 1 / 1.2
		CP = 1.2 / 1 / 0.8
	}
}

