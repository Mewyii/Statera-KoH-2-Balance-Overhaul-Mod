		}
	}

	cons = 100
	{	
		pc_we_have_bad_relation	{ max = 20;	pow = 2 }
		pc_they_rule_our_people { our_kingdom = 10; our_culture = 5; our_culture_family = 1; max = 20 }
		pc_our_army_is_stronger { max = 20 }
