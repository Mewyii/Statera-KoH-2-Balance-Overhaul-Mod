def KingdomAI
{
	//Diplomatic importance calculation
	float dip_imp_recent_rel_change_min_time = 5
	float dip_imp_recent_rel_change_max_time = 30
	float dip_imp_player_recent_rel_change = 2000
	float dip_imp_player_cooldown_min = 0
	float dip_imp_player_cooldown_max = 300
	float dip_imp_player_cooldown_power = 2.5
	float dip_imp_neighbor = 3000
	float dip_imp_second_neighbor = 500
	float dip_imp_second_neighbor_max_dist = 2
	float dip_imp_second_kin = 1500
	float dip_imp_crusade_or_jihad = 3000
	float dip_imp_ally = 2000
	float dip_imp_have_trade = 250
	float dip_imp_have_exclusive_trade = 0 // this is obsolete for now
	float dip_imp_currently_trading_mod = 2
	float dip_imp_player_boost_mul = 2
	float dip_imp_player_boost_distance_max = 3
	float dip_imp_map_distace_min = 1
	float dip_imp_map_distace_max = 5
	float dip_imp_war = 4000
	float dip_imp_liege = 1500
	float dip_imp_vassal = 1000
	float dip_imp_large_relations_min = 300
	float dip_imp_large_relations_factor = 500
	float dip_imp_ai_offer_min_time = 150
	float dip_imp_ai_offer_pow = 3

    float break_siege_estimation_strong = 65
    float break_siege_strong_army_low_food = 55
    float break_siege_strong_army_low_food_chance = 35
    float break_siege_weak_army_no_food_chance = 5
	float retreat_fight_cooldown = 30 // can't attack if you retreated recently, hacky fix for when you know the target is too strong

	int max_num_mercenaries = (5 - num_armies) // at 4 marshals in court, you get 1 mercenary at most, at 0 marshals you get 5 mercenaries
	int max_army_equipment = 4
}

extend RealmCost
{
	base = 2000
	population_is_loyal_to_us = 4000
	population_has_our_religion = 2000
	per_settlement = 750
	per_province_feature = 1000
	per_province_feature_we_have_elsewhere = 500
	trade_center = 2500
	per_trade_center_zone_realm = 50
	is_religious_center_from_our_religion = 20000
	is_religious_center_from_other_religion = 5000
	per_siege_defense = 10
	building_cost_mult = 0.2
	kingdom_to_size_value = 15000 // value = x / kingdom size

	multiplier = 1
}

