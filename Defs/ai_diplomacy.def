delete PC_WeWouldBecomeTheirVassal
def PC_WeWouldBecomeTheirVassal : ProsAndCons
{
	//note - these are on top on accepting peace
	cost = (20000 + (our_kingdom.num_realms * 1000))

	pros = (10 + If((our_kingdom.num_realms < 2), 10, 0) + If((our_kingdom.culture_group == their_kingdom.culture_group), 10, 0))
	{
		pc_they_are_X_times_larger = 20 { X = 1.5; added_realms = 2 }
		pc_our_army_is_weaker { max = 30 }
		pc_we_are_losing { max = 20 }
		pc_they_are_caliphate_and_we_are_muslim = 20
		pc_they_hold_Constantinople_and_we_are_Ortodox = 20 //they are our boss
		pc_we_share_same_religion = 15
	}

	cons = (30 + (min(((our_kingdom.num_realms - 1) * 30), 200)) + (our_kingdom.num_vassals * 10)) 
	{
		pc_we_are_X_times_larger = 100 { X = 1; added_realms = 1 }
		pc_we_have_caliphate = 40 //caliphate is lost in vassalage
		pc_we_are_papacy = 40
		pc_our_army_is_stronger { max = 30 }
		pc_we_are_wining { max = 20 }
		pc_they_are_excommunicated_and_we_are_catholic = 15
		pc_they_have_too_many_wars { at_war_base = 0; per_additional_war = 10; max = 15}
		pc_we_have_supporters { per_supporter = 10 }
		pc_we_both_have_under_X_towns = 10 { X = 3 }
		pc_they_are_player_by_difficulty
		{
			easy = 0
			normal = 0
			hard = 10
			very_hard = 20
		}
	}

	//NB this is needed as at this stage we hate each other so much pro points will be deminished and cons - multiplied a lot
	//and we don't want to reduce con points, as we don't want this to happen just because we like each other
	relationship_scale
	{
		PP = 1 / 1 / 1
		CP = 1 / 1 / 1
	}

	thresholds
	{
		propose = 1.2
		accept = 1
	}
}

