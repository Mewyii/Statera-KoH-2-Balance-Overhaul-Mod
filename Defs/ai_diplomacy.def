delete PC_Peace
def PC_Peace : ProsAndCons
{
	cost = (5000 + (our_kingdom.num_realms * 500))

	relationship_scale
	{
		PP = 0.9 / 1 / 1.1
		CP = 1.1 / 1 / 0.9
	}

	pros = (10  + (our_kingdom.num_disorder_realms * 10))
	{
		pc_we_have_too_many_wars { max = 100; at_war_base = 0; per_additional_war = 50 }
		pc_we_have_war_exhaustion {	max = 100; pow = 1.5 }
		pc_we_are_losing { max = 50 }
		pc_they_are_too_far = 50 { threshold = (min((ceil(our_kingdom.num_costal_realms / 2)), 3)) }
		pc_they_hold_our_king = 30
		pc_we_have_rebels {	max = 30; per_rebel = 15 }
		pc_we_have_too_many_captured_knights {per_prisoner = 5; minimum_prisoners = 0;	max = 25}
		pc_our_authority_is_low { per_negative_point = 5 }
		pc_their_diplomat_is_negotiating_peace { base = 25; tick = 30; per_tick = 1; level_mul = 2 }
		pc_we_are_catholic_and_they_are_papacy = 20
		pc_we_have_no_border = (If((our_kingdom.num_costal_realms < 1), 20, 5))
		pc_they_hold_our_prince = 15
		pc_we_have_good_relation { base = 2; max = 15; pow = 0.5 }
		pc_we_have_common_enemies = 15
		pc_we_rule_their_people { their_kingdom = 8; their_culture = 4; their_culture_family = 2; max = 10 }
		pc_they_have_supporters { per_supporter = 5 }
		pc_we_are_leader_and_they_are_big_enemy_supporter { max = 15; per_province = 3 }
		pc_they_control_the_pope = 10
		pc_we_share_same_liege = 10
		pc_we_have_common_allies = 5
		pc_we_share_same_religion = 5
		pc_we_hate_our_alliance_leader { max = 5 }
	}

	float player_boost = (If(their_kingdom.is_player, (min(their_kingdom.num_realms, 10)), 0))
	cons = (10 + (If((our_kingdom.culture_group == their_kingdom.culture_group), 10, 20)) + player_boost)
	{
		pc_war_just_started { max = 30; minutes = 15; pow = 3 }		
		pc_we_are_wining { max = 25 }
		pc_we_didnt_really_fight_yet { max = 20; time_flat = 300; time_fade_out = 300; points = 5 }
		pc_we_are_supporting_our_liege = 20
		pc_we_are_X_times_larger = 15 {	X = 1.75 ; added_realms = 3}
		pc_we_want_to_liberate_rome = 15
		pc_they_hold_our_holy_cities_and_we_are_Sunni {	shia_control = 5; other_religion_control = 15 }
		pc_they_hold_Baghdad_and_we_are_Shia { sunni_control = 5; other_religion_control = 15 }
		pc_they_have_too_many_wars { at_war_base = 0; per_additional_war = 10; max = 15}
		pc_we_have_supporters { per_supporter = 5 }
		pc_they_have_too_many_captured_knights = { per_prisoner = 3; minimum_prisoners = 0;	max = 12 }
		pc_they_are_excommunicated_and_we_are_catholic = 10
		pc_our_army_is_stronger { max = 10 }
		pc_they_have_rebels	{ max = 10; per_rebel = 3 }
		pc_there_are_our_loyalists = 10 
		pc_we_both_have_under_X_towns = 10 { X = 2 }
		pc_we_love_our_alliance_leader { max = 5 }
		pc_they_fight_our_friends { max = 5; per_kingdom = 5; threshold = 300 }
		pc_they_are_player_by_difficulty
		{
			easy = 0
			normal = 0
			hard = 10
			very_hard = 20
		}
	}

	thresholds
	{
		accept_peace = 1.0
		offer_peace = 1.2
	}
}

