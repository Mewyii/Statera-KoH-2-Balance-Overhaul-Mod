extend ProsAndCons 
{	
	cost = 10000
	max_consider_treshold_delta = 0.6

	relationship_scale
	{
		PP = 0.7 / 1 / 1.3
		CP = 1.3 / 1 / 0.7
	}
}

delete PC_Crusade
def PC_Crusade : ProsAndCons
{
	pros 
	{
        pc_they_hold_Rome = 50
		pc_they_fight_catolics { max = 60; per_war = 30 }
		pc_they_usurp_jerusalem = 30
		pc_they_are_at_war_with_papacy = 30
        pc_they_have_different_religion = (10 + If((their_kingdom.num_costal_realms > 1),10,0))
		pc_they_hold_many_christian_provinces { max = 15; per_province = 5; constantinople = 5 }
        pc_they_have_caliphate = 10
        pc_they_are_excommunicated_and_we_are_catholic = 10
		pc_they_fight_our_friends { max = 10; per_kingdom = 3; threshold = 300 }
        pc_we_are_their_vassal = 10
        pc_they_have_many_trade_centers = 5
        pc_they_recently_disobeyed_papacy  { max = 5; pow = 1 }
        pc_they_have_war_exhaustion	{ max = 5 }
		pc_they_have_rebels	{ max = 5; per_rebel = 2 }
	}

	cons = 20
	{
        pc_they_are_papacy = 100
		pc_they_control_the_pope = 30
		pc_they_are_our_vassal = 30
		pc_we_are_allies = 20
        pc_we_have_common_enemies {	max = 15; per_enemy = 5	}
		pc_they_are_active_against_our_enemies = 15 { percent_active = 70; max_minutes = 15 }
		pc_they_are_loved_by_catholics = 15 { threshold = 250 }
		pc_they_recently_aided_papacy {	max = 10; pow = 1 }
		pc_we_have_trade = 5
		pc_they_are_player_by_difficulty
		{
			easy = 10
			normal = 0
			hard = 0
			very_hard = 0
		}
	}

	relationship_scale
	{
		PP = 1.3 / 1 / 0.7
		CP = 0.7 / 1 / 1.3
	}

	thresholds
	{
		//accept = 1.2 //this is a papacy think, kingdoms have no say to accept or decline it
		propose = 1.2
	}
}

delete PC_Propose_AskForCrusadeOffer
def PC_Propose_AskForCrusadeOffer : ProsAndCons
{
	cost = 20000
	pros = ((their_kingdom.num_realms + their_kingdom.num_vassals_realms) / 2)
	{
		pc_they_are_loved_by_catholics = 30 { threshold = 250 }
		pc_we_have_good_relation { base = 5; max = 25; pow = 0.5}
		pc_they_control_the_pope = 20
		pc_their_authority_is_high { per_positive_point = 2 }
		pc_they_recently_aided_papacy = 5
	}

	cons = 5
	{
		pc_ask_for_crusade_cooldown = 1000
		pc_we_have_bad_relation { max = 50;	pow = 2 }
		pc_they_are_hated_by_catholics = 30 { threshold = -250 }
		pc_they_fight_our_friends = 5
	}

	PC_WeWantSomeoneToAttackThem = [ (PP), (CP) ]
	{
		their_kingdom = (offer.arg)
	}

	thresholds
	{
		propose = 1.2
	}
}

delete PC_Accept_AskForCrusadeOffer
def PC_Accept_AskForCrusadeOffer : ProsAndCons
{
	cost = 10000
	pros
	{
		pc_their_influence_in_our_kingdom { max = 30 }
		pc_we_are_their_vassal = 30
		pc_we_have_good_relation { base = 5; max = 20; pow = 0.5}
		pc_our_trade_level { max = 10 }
		pc_their_trade_level { max = 10 }
	}

	cons
	{
		pc_we_have_too_many_wars { max = 15; at_war_base = 5; per_additional_war = 10 }
		pc_we_have_rebels {	max = 15; per_rebel = 5 }
		pc_our_authority_is_low { per_negative_point = 2 }
		pc_they_fight_our_friends { max = 15; per_kingdom = 5; threshold = 300 }
		pc_we_have_bad_relation { max = 10;	pow = 1 }
	}

	add_pros_and_cons
	{
		PC_Crusade = [ (PP), (CP) ]
		{
			their_kingdom = (offer.arg)
		}
	}

	thresholds
	{
		accept = 1
	}
}

// War Tendency - This also has something to do with declaring wars!
delete PC_War
def PC_War : ProsAndCons
{
	float enemy_gang_up_modifier = (min((their_kingdom.num_wars * 5), 10))

	float enemy_wars_modifier = (min(their_kingdom.num_wars, 2))
	float enemy_size_modifier = (If((their_kingdom.num_realms > 9), 1, 0.1))
	float enemy_empire_gang_up_modifier = (10 * enemy_wars_modifier * enemy_size_modifier)

	pros = (30 + (their_kingdom.resources.gold / 2000) + (our_kingdom.num_marshals * 3) + ((their_kingdom.num_realms / their_kingdom.num_marshals) * 1.5) + enemy_gang_up_modifier + enemy_empire_gang_up_modifier)
	{
		pc_we_plan_invasion_and_allies_are_ready { max = 50; per_ally_province = 5; per_ally = 15; per_ally_war = -5 }
		pc_they_plan_invasion_against_us { max = 30; per_ally_province = 10 }
		pc_they_rule_our_lands	{ per_historical_realm = 5; per_core_realm = 5;	max = 30 }
		pc_they_rule_our_people { our_kingdom = 10; our_culture = 5; our_culture_family = 2; max = 30 }
		pc_our_army_is_stronger { max = 25 }
		pc_we_have_bad_relation	{ max = 25;	pow = 1 }
		pc_we_want_to_liberate_rome = 20
		pc_they_hold_our_holy_cities_and_we_are_Sunni {	shia_control = 10; other_religion_control = 20 }
		pc_they_hold_Baghdad_and_we_are_Shia { sunni_control = 10; other_religion_control = 20 }
		pc_they_hold_our_king = 20
		pc_they_are_excommunicated_and_we_are_catholic = 15
		pc_we_are_both_caliphates = 15
		pc_there_are_our_loyalists = 15 
		pc_they_fight_our_friends { max = 15; per_kingdom = 6; threshold = 300 }
		pc_they_have_rebels	{ max = 15; per_rebel = 5 }
		pc_war_just_started { max = 15; minutes = 15; pow = 1.5 }
		pc_we_are_X_times_larger = 10 {	X = 1.75 ; added_realms = 3}
		pc_our_authority_is_high { per_positive_point = 2 }
		pc_their_authority_is_low { per_negative_point = 2 }
		pc_they_hold_our_prince = 10
		pc_they_have_different_religion = 8
		pc_we_both_have_under_X_towns = 5 { X = 2 }
		pc_their_king_is_venerable = 5
		pc_we_can_gain_sea_outlet = 5
		pc_they_are_player_by_difficulty
		{
			easy = 0
			normal = 5
			hard = 15
			very_hard = 25
		}
	}

	cons = (If((our_kingdom.culture_group == their_kingdom.culture_group), 10, 0) + (our_kingdom.num_disorder_realms * 5) + If((our_kingdom.resources.gold < (1000 + (our_kingdom.num_realms * 100))), 15, 0))
	{
		pc_we_have_war_exhaustion {	max = 100; pow = 1.5 }
		pc_we_have_too_many_wars { max = 100; at_war_base = 60; per_additional_war = 40 }
		pc_we_have_too_many_captured_knights {per_prisoner = 10; minimum_prisoners = 0;	max = 50}
		pc_they_are_too_far = 50 { threshold = (min((ceil(our_kingdom.num_costal_realms / 2)), 3)) }
		pc_our_authority_is_low { per_negative_point = 10 }
		pc_we_have_rebels {	max = 50; per_rebel = 15 }
		pc_we_need_peace_time { max = 50; minutes = 30; pow = 2 }
		pc_we_have_nap = 40
		pc_their_defensive_pact_against_us { max = 30; per_ally_province = 5 }
		pc_we_are_family { our_prince_or_princess = 20;	our_king = 30 } 
		pc_they_are_our_vassal = 30
		pc_we_have_no_border = (If((our_kingdom.num_costal_realms < 1), 25, 10))
		pc_we_are_allies = 20
		pc_we_have_truce = 20
		pc_we_are_catholic_and_they_are_papacy = 20
		pc_we_are_papacy = 20
		pc_they_control_the_pope = 20
		pc_our_trade_level { max = 20 }
		pc_our_king_is_venerable = 15
		pc_we_are_their_vassal = (15 - ((our_kingdom.num_realms - 1) * 3))
		pc_their_vassals {max = 15; per_march = 10; per_march_province = 2}
		pc_their_sovereign {max = 10; scuttage_factor = 6; per_ally = 1; per_province = 1}
		pc_we_have_common_enemies {	max = 10; per_enemy = 5 }
		pc_we_have_good_relation { base = 2; max = 10; pow = 0.5 }
		pc_our_army_is_weaker { max = 10 }
		pc_they_are_X_times_larger = 10 { X = 1.75 ; added_realms = 3 }
		pc_we_just_had_peace = 10 { minutes = 5}
		pc_we_share_same_religion = 10
		pc_we_share_same_liege = 10
		pc_their_trade_level { max = 5 }
	}

	relationship_scale
	{
		PP = 1.3 / 1 / 0.7
		CP = 0.7 / 1 / 1.3
	}

	thresholds
	{
		declare_war = 1.2
		declare_independence = 1.4
	}
}

delete PC_Propose_DeclareWar
def PC_Propose_DeclareWar : PC_War
{
	thresholds
	{
		propose = 1.2
		accept = 1
	}
}

delete PC_WeCanHaveOurIndependence
def PC_WeCanHaveOurIndependence : PC_Propose_DeclareWar
{
	cost = 30000

	pros = (((our_kingdom.num_realms - 1 + our_kingdom.num_marshals - 1) * 5) + (round(their_kingdom.num_vassals / their_kingdom.num_realms) * 10))
	{
		pc_we_are_X_times_larger = 60 {	X = 1 ; added_realms = 1}
		pc_they_are_too_far = 40 { threshold = 3 }
		pc_we_have_caliphate = 40
		pc_liege_attacked_other_vassal = 20
		pc_our_authority_is_high { per_positive_point = 4 }
		pc_they_have_too_many_wars { at_war_base = 5; per_additional_war = 5; max = 15}
		pc_we_have_no_border = 10
		pc_their_authority_is_low { per_negative_point = 2 }
		pc_our_liege_have_many_vassals
	} 

	cons 
	{
		pc_they_are_new_liege { max = 80; max_time = 600; pow = 2 }
		pc_we_need_peace_time { max = 50; minutes = 30; pow = 1.5 }
		pc_they_hold_our_king = 40
		pc_they_are_Germany_and_we_are_their_vassals = 15
		pc_they_have_caliphate = 15
		pc_their_authority_is_high { per_positive_point = 5 }
		pc_they_hold_our_prince = 10
		pc_we_have_good_relation { base = 1; max = 5; pow = 0.5 }
	}

	thresholds
	{
		propose = 1.2
	}
}

delete PC_Propose_ClaimIndependence
def PC_Propose_ClaimIndependence : PC_WeCanHaveOurIndependence
{
	thresholds
	{
		propose = 1.2
	}
}

