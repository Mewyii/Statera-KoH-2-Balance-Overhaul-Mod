def District
{
	float panels_spacing = 2 // spacing between districts
	panel_min_width = 120
	icon_size = 110,100
	panel_padding = 8
}

extend CommonDistrict
{
    delete buildings
	buildings
	{	
		HillFort
		PirateHaven { prerequisites { Harbor } }
		Viticulture
		SheepFarming
		CattleFarming
		HorseBreeding
		Woodworking
		Stoneworking
		Metalworking
		FightingGrounds
		HuntingGrounds
		BreedingGrounds
		SacredGrounds
		KhansTent
		KhansCourt { prerequisites { KhansTent } }
	}
}

def PFDistrict : District
{
	delete buildings
	buildings
	{
		LimeTrade { prerequisites { Stoneworking; MarketSquare } }

		LodestoneTrade { prerequisites { Metalworking; MarketSquare } }
		SilverSmelting { prerequisites { Metalworking; MarketSquare } }
		GoldSmelting { prerequisites { Metalworking; MarketSquare } }

		AmberTrade { prerequisites { MarketSquare } }
		MineralsTrade { prerequisites { MarketSquare } }
		
		CamelsTrade { prerequisites { MarketSquare } }
		FurTrade { prerequisites { MarketSquare } }

		SaltTrade { prerequisites { MarketSquare } }
		SaltpeterTrade { prerequisites { MarketSquare } }		
		SulfurTrade { prerequisites { MarketSquare } }
	}
}

def CastlesDistrict : District
{
	delete buildings
	buildings
	{
		TrainingField = 1,1
		ArmyStables = 2,1

		CityWatch = 1,2 { prerequisites { TrainingField } }
		ArmySiegeWorkshop = 2,2

		Armory = 1,3 { prerequisites { TrainingField; Blacksmith } }

		ArmyBarracks_Christian = 2,3 { prerequisites { TrainingField; School_Christian } }

		ArmyBarracks_Muslim = 2,3 { prerequisites { TrainingField; School_Muslim } }
	}
}

def VillagesDistrict : District
{
	delete buildings
	buildings
	{
		MarketSquare = 1,1

		MerchantHall = 1,2 { prerequisites { MarketSquare } }

		MerchantsGuild = 1,3 { prerequisites { MerchantHall } }

		GreatBazaar = 1,3 { prerequisites { MerchantHall } }
	}
}

def MonasteriesDistrict : District
{
	delete buildings
	buildings
	{
		Church = 1,1
		Temple = 1,1

		CityMonastery = 2,1

		Cathedral = 1,2 { prerequisites { Church } }

		EcclesiasticalCourt = 2,2 { prerequisites { Church; Dungeon } }
		EpiscopalPalace = 1.5,3 { prerequisites { StonemasonsGuild; Cathedral; EcclesiasticalCourt } }

		Masjid = 1.5,1
		GreatMosque = 1,2 { prerequisites { Masjid } }	
		ShariaCourt = 2,2 { prerequisites { Masjid } }	
		DarAlImara = 1.5,3 { prerequisites { GreatMosque } }	
	}
}

extend CropFarmsDistrict
{
    delete buildings
	buildings
	{
		CropFarming = 1,1

		Windmill = 1,2 { prerequisites { CropFarming } }

		WeavingMill = 1,3
	}
}

def RiverDistrict : District
{
	name = "River"
	color = "#3F5B6ACC"
	
	requires { Rivers }
	caption_count = (farms_count)

	buildings
	{
		RiverDocks = 1,1

		Irrigation = 1,2 { prerequisites { CropFarming } }
	}
	
	backgroud = "Assets/UI/Elements/BuildingSlots/Element_BuildingSlot_District_SeaShore.png:Element_BuildingSlot_District_SeaShore#2" //GUID:aaaa3cdb5696fbe4f8714a25d6792b07
	border = "Assets/UI/Elements/BuildingSlots/Element_BuildingSlot_DistrictCirlce_SeaShore.png:Element_BuildingSlot_DistrictCirlce_SeaShore#2" //GUID:6d754f25da00eb440a6c0c8542bfea7e
}

def SeaShoreDistrict : District
{
	name = "Sea"
	color = "#3F5B6ACC"
	
	requires { Coastal }

	caption_count = (coastal_settlements_count)
	delete buildings
	buildings
	{
		FishingDocks = 2,1
		Harbor = 1,1

		TradePort = 1,2 { prerequisites { Harbor } }
		Shipyard = 2,2 { prerequisites { Harbor } }
		
		ItalianTraderQuarters = 1,3 { prerequisites { TradePort } }	
		Admiralty = 2,3 { prerequisites { StonemasonsGuild; Shipyard } }

		ForeignTraderQuarters = 1,3 { prerequisites { TradePort } }	
		DiwanAlBahr = 2,3 { prerequisites { StonemasonsGuild; Shipyard } }
	}
	
	backgroud = "Assets/UI/Elements/BuildingSlots/Element_BuildingSlot_District_SeaShore.png:Element_BuildingSlot_District_SeaShore#2" //GUID:aaaa3cdb5696fbe4f8714a25d6792b07
	border = "Assets/UI/Elements/BuildingSlots/Element_BuildingSlot_DistrictCirlce_SeaShore.png:Element_BuildingSlot_DistrictCirlce_SeaShore#2" //GUID:6d754f25da00eb440a6c0c8542bfea7e
}


def CraftingDistrict: District
{
	name = "Crafting"
	color = "#9a821fcc"
	
	caption_count = (villages_count)

	buildings
	{
		Workshop = 1,1
		Blacksmith = 2,1
		Tanneries = 3,1

		CraftsmensGuild = 1,2 { prerequisites { Workshop } }
		StonemasonsGuild = 2,2 { prerequisites { Workshop } }
		BlacksmithsGuild = 3,2 { prerequisites { Blacksmith } }

		MasterWorkshop = 1,2 { prerequisites { Workshop } }
		MasterStonemason = 2,2 { prerequisites { Workshop} }
		MasterBlacksmith = 3,2 { prerequisites { Blacksmith } }
	}
}

def EducationDistrict : District
{
	name = "Education"
	color = "#185a9dcc"
	
	caption_count = (villages_count)
	
	buildings
	{
		School_Christian = 1,1

		Library_Christian = 1,2 { prerequisites { School_Christian } }

		University_Christian = 1,3 { prerequisites { Library_Christian } }

		School_Muslim = 1,1

		Library_Muslim = 1,2 { prerequisites { School_Muslim } }

		University_Muslim = 1,3 { prerequisites { Library_Muslim } }
	}
}

def CultureDistrict : District
{
	name = "Culture"
	color = "#2b9088cc"
	
	caption_count = (villages_count)

	buildings
	{
		TownHall_Christian = 1,1 { prerequisites { MarketSquare } }

		TournamentGrounds_Christian = 1,2 { prerequisites { Armory } }

		Theater_Christian = 1,3 { prerequisites { StonemasonsGuild } }

		TownHall_Muslim = 1,1 { prerequisites { MarketSquare } }

		Bathhouse_Muslim = 1,2

		Bimaristan = 1,3
	}
}

def PunishmentDistrict : District
{
	name = "Punishment"
	color = "#a10505cc"
	
	caption_count = (keeps_count)

	buildings
	{
		Dungeon = 1,1

		CityPrison = 1,2

		CourtHall = 1,3 { prerequisites { CityPrison } }
	}
}


