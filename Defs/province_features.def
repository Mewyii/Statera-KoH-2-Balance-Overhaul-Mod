{
	name = "Dye Extraction"
	flavor = "Dye Extraction description."
	tooltip = "The cultivation and extraction of natural dyes formed the basis of medieval textile dyeing. Regions with high-quality dye plants or dyes supplied clothmakers and dyers with sought-after raw materials."
