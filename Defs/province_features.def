def AlumDeposits : ProvinceFeature
{
	name = "Alum Deposits"
	flavor = "Alum description."
	tooltip = "Alum is an indispensable mordant used in dyeing and tanning. Regions with alum deposits supply textile centers with one of the most important raw materials of the medieval craft economy."
	icon = "Assets/Icons/Features/Alum.png:Alum#1"
	icon_big = "Assets/Icons/Features/Alum.png:Alum#1"

	spawn_chance = 0
	{
		Mountains = 6
	}
}

