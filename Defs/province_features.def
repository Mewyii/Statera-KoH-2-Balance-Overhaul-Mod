}

def IncenseCultivation : ProvinceFeature
{
	name = "Incense Cultivation"
	flavor = "Incense Cultivation description."
	tooltip = "Frankincense was one of the most valuable fragrances and commodities in the medieval world. The resin of the frankincense tree was used in religious ceremonies, medicine, and perfumes, and was transported to Europe and Asia via caravan and maritime trade routes."
	icon = "Assets/Icons/Features/Frankincense.png:Frankincense#1"
	icon_big = "Assets/Icons/Features/Frankincense.png:Frankincense#1"

	spawn_chance = 6
	area = [0, 0, 1, 0.25]
}

