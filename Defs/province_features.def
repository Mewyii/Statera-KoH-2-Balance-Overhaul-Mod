def Grasslands : ProvinceFeature
{
	name = "Grasslands"
	flavor = "Grasslands description."
	tooltip = "Fertile pastureland suitable for raising livestock. It allows for the establishment of sheep, cattle, and livestock farms and provides the basis for the production of wool, leather, and milk."
	icon = "Assets/Icons/Features/Grassland.png:Grassland#1"
	icon_big = "Assets/Icons/Features/Grassland.png:Grassland#1"
	spawn_chance = 70
	area = [0, 0.25, 1, 0.9] //Basically excludes the southern deserts
}

def Forests : ProvinceFeature
{
	name = "Forests"
	flavor = "Deep Forests description."
	tooltip = "Dense forests provide lumber, firewood, and game. They support logging, charcoal production, beekeeping, and hunting, and form the basis for numerous crafts."
	icon = "Assets/Icons/Features/Forest.png:Forest#1"
	icon_big = "Assets/Icons/Features/Forest.png:Forest#1"
	spawn_chance = 80
	area = [0, 0.25, 1, 1] //Basically excludes the southern deserts
}

def Swamps : ProvinceFeature
{
	name = "Swamps"
	flavor = "Swamps description."
	tooltip = "Moors, swamps, and wetlands make settlement difficult, but they provide peat, reeds, and fish, and offer natural protection from attackers."
	icon = "Assets/Icons/Features/Swamp.png:Swamp#1"
	icon_big = "Assets/Icons/Features/Swamp.png:Swamp#1"
	spawn_chance = 7
	area = [0, 0.6, 0.8, 0.85]
}

def Desert : ProvinceFeature
{
	name = "Desert"
	flavor = "Desert description."
	tooltip = "Arid and inhospitable landscapes offer few opportunities for agriculture. They make travel and supply difficult, but they facilitate caravan trade and the use of oases."
	icon = "Assets/Icons/Features/Desert.png:Desert#1"
	icon_big = "Assets/Icons/Features/Desert.png:Desert#1"
	spawn_chance = 0
	area = [0, 0, 1, 0.3] 
}

def Oasis : ProvinceFeature
{
	name = "Oasis"
	flavor = "Oasis description."
	tooltip = "Oases are fertile islands in the midst of arid landscapes. They provide travelers with water and food and serve as natural resting places and trading posts along major caravan routes."
	icon = "Assets/Icons/Features/Oasis.png:Oasis#1"
	icon_big = "Assets/Icons/Features/Oasis.png:Oasis#1"
	
	area = [0, 0, 1, 0.3] 
	spawn_chance = 100
	special = true
}

def Steppe : ProvinceFeature
{
	name = "Steppe"
	flavor = "Steppe description."
	tooltip = "Vast, sparsely wooded semi-arid grasslands are ideal for raising horses and livestock. They facilitate a nomadic way of life."
	icon = "Assets/Icons/Features/Steppe.png:Steppe#1"
	icon_big = "Assets/Icons/Features/Steppe.png:Steppe#1"
	
	area = [0.675, 0.5, 1, 0.72]
	spawn_chance = 100
	special = true
}

def Rivers : ProvinceFeature
{
	icon = "Assets/Icons/Features/River.png:River#1"
	icon_big = "Assets/Icons/Features/River.png:River#1"
}

def Vines : ProvinceFeature
{
	name = "Vines"
	flavor = "Vines description."
	tooltip = "Wine was one of the most important agricultural products of the Middle Ages. It served as an everyday beverage, sacramental wine, and a major commodity, and shaped numerous cultural landscapes in Europe and the Mediterranean region."
	icon = "Assets/Icons/Features/Vines.png:Vines#1"
	icon_big = "Assets/Icons/Features/Vines.png:Vines#1"
	
	spawn_chance = 100
	area = [0, 0.25, 0.95, 0.65]
	special = true
}

def Horses : ProvinceFeature
{
	name = "Horse Breeding"
	flavor = "Horses description."
	tooltip = "Horse breeding enables the development of fast cavalry and provides high-quality animals for war, transportation, and prestige. Certain regions are known for horse breeds that are particularly enduring or strong."
	icon = "Assets/UI/Elements/Common/Icons/ProvinceFeatures/Icon_ProvinceFeature_Horses.tga:Icon_ProvinceFeature_Horses#2" //GUID:279e3f6f84ddf094b9dc2683947f2b7b
	icon_big = "Assets/UI/Elements/Common/Icons/ProvinceFeatures/Icon_ProvinceFeature_Horses_60x60.tga:Icon_ProvinceFeature_Horses_60x60#2" //GUID:23a021969bdd81343a071f9389ff2d16

	area = [0, 0.1, 1, 0.8]
	spawn_chance = 100
	special = true
}

def Camels : ProvinceFeature
{
	name = "Camels"
	flavor = "Camels description."
	tooltip = "Camels are the backbone of long-distance trade across deserts and arid steppes. They enable caravans to travel long distances and facilitate the economic development of arid regions."
	icon = "Assets/UI/Elements/Common/Icons/ProvinceFeatures/Icon_ProvinceFeature_Camels.tga:Icon_ProvinceFeature_Camels#2" //GUID:82bc47dc5071c60488feb195e4f0dcce
	icon_big = "Assets/UI/Elements/Common/Icons/ProvinceFeatures/Icon_ProvinceFeature_Camels_60x60.tga:Icon_ProvinceFeature_Camels_60x60#2" //GUID:c0b153ba87f119343856d45bd992ec43
	
	area = [0, 0, 0.87, 0.2]
	
	spawn_chance = 50
	special = true
}

def SlaveTradersAfrica : ProvinceFeature
{
	name = "Slave Trade (Africa)"
	flavor = "Slave Trade description."
	tooltip = "The slave trade was one of the most lucrative but also one of the most cruel economic sectors of the Middle Ages. Caravans and coastal cities supplied captives from West, East, and Central Africa to the markets of North Africa, Egypt, and the Middle East."
	icon = "Assets/Icons/Features/SlaveTraders.png:SlaveTraders#1"
	icon_big = "Assets/Icons/Features/SlaveTraders.png:SlaveTraders#1"
	
	area = [0, 0, 0.88, 0.22]
	spawn_chance = 2
}

def SlaveTradersRussia : ProvinceFeature
{
	name = "Slave Trade (Caucasus and Steppe)"
	flavor = "Slave Trade description."
	tooltip = "The slave trade was one of the most lucrative but also one of the most cruel economic sectors of the Middle Ages. Border regions between settled empires and the steppe peoples supplied captives for the markets of the Mediterranean, Egypt, and the Middle East."
	icon = "Assets/Icons/Features/SlaveTraders.png:SlaveTraders#1"
	icon_big = "Assets/Icons/Features/SlaveTraders.png:SlaveTraders#1"
	
	area = [0.75, 0.3, 1, 0.8]
	spawn_chance = 2
}

def Pirates : ProvinceFeature
{
	name = "Pirates"
	tooltip = "Sheltered bays, rugged coastlines, and remote islands offer pirates and buccaneers ideal hideouts. Those who tolerate or support their activities can profit from raids on trade routes and the spoils."
	category = "Society"
	spawn_chance = 10
	requre_costal = true
	requre_distant_port = true
	icon_big = "Assets/UI/Elements/Common/Icons/ProvinceFeatures/Icon_ProvinceFeature_Pirates_60x60.tga:Icon_ProvinceFeature_Pirates_60x60#2" //GUID:17804d103ed73b24c8afee901aaed2ce
	icon = "Assets/UI/Elements/Common/Icons/ProvinceFeatures/Icon_ProvinceFeature_Pirates.tga:Icon_ProvinceFeature_Pirates#2" //GUID:54c3be7b0914c64448465e8d0c8b91ad
}

def SpiceTraders : ProvinceFeature
{
	name = "Spice Trade"
	flavor = "Spice Traders description."
	tooltip = "Precious spices from India, Arabia, and Southeast Asia reached the Mediterranean region via caravans and sea routes. Regions along these trade routes benefited from one of the most lucrative long-distance trade goods of the Middle Ages."
	icon = "Assets/Icons/Features/SpiceTrader.png:SpiceTrader#1"
	icon_big = "Assets/Icons/Features/SpiceTrader.png:SpiceTrader#1"
	
	area = [0.65, 0, 1, 0.35]
	spawn_chance = 2
}

