extend Upgrade 
{
	float base_ai_eval = 250
	ai_eval = (base_ai_eval)
}

// MILITARY
def ArcheryRange : Upgrade
{
	name = "Archery Range"
	flavor = "Dedicated grounds for bowmen to practice accuracy and volleys under the watch of instructors."
	icon = "Assets/Icons/Buildings/ArcheryRange.png:ArcheryRange#1"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 500)
}

def MilitiaDrills : Upgrade
{
	name = "Militia Drills"
	flavor = "Regular weapons practice turns untrained townsmen into more reliable soldiers. Under the watchful eye of the arms master, they learn to fight together and hold their ranks."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_TownGuardsQuarters.tga:UI_Structure_Icon_TownGuardsQuarters#2" //GUID:aad5edb51f1398f4fb75c0a35fccd4ce
	
	ai_category = "Military"
}

def MilitiaOffices : Upgrade
{
	name = "Militia Offices"
	flavor = "Experienced watch captains and their subordinates oversee the recruitment, organization, and command of the town militia. Under their direction, townsmen are assigned to units and kept ready for watch duty or wartime musters."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_TownGuardsQuarters.tga:UI_Structure_Icon_TownGuardsQuarters#2" //GUID:aad5edb51f1398f4fb75c0a35fccd4ce
}

def LesserFiefs : Upgrade
{
	name = "Lesser Fiefs"
	flavor = "Fiefs are granted to lesser nobles and worthy men in service as fortified estates spread across the realm. This increases the number of men with the means to maintain themselves in permanent mounted service."
	icon = "Assets/Icons/Buildings/KnightlyTrainingGrounds.png:KnightlyTrainingGrounds#1"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 500)
}

def KnightlyTrainingGrounds : Upgrade
{
	name = "Knightly Training Grounds"
	flavor = "At the training grounds of castles and noble courts, knights and squires practise riding, lance fighting, and mounted combat. Regular exercises hone their skill and discipline and prepare them for war."
	icon = "Assets/Icons/Buildings/KnightlyTrainingGrounds.png:KnightlyTrainingGrounds#1"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 500)
}

def LanceWarfare : Upgrade
{
	name = "Lance Warfare"
	flavor = "The use of the lance develops into a refined art of knightly warfare. Close charges and disciplined use of the lance give heavy cavalry its feared striking power."
	icon = "Assets/Icons/Buildings/KnightlyTrainingGrounds.png:KnightlyTrainingGrounds#1"
	add_tooltip = "Required for recruiting {clr:enables_color}High Knight Units{/clr}"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 250)
}

def LordsHalls : Upgrade
{
	name = "Lords' Halls"
	flavor = "Powerful lords establish grand courts and fortified residences capable of supporting large households and retinues. As noble wealth grows, their houses can equip and sustain more knights in their service."
	icon = "Assets/Icons/Buildings/KnightlyTrainingGrounds.png:KnightlyTrainingGrounds#1"
	add_tooltip = "Required for recruiting {clr:enables_color}Late Knight Units{/clr}"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 250)
}

def Chivalry : Upgrade
{
	name = "Chivalry"
	flavor = "Honour, courage, and duty to lord and retinue increasingly shape the ideals of knighthood. Mounted service becomes not merely a craft of war, but a distinct estate with its own virtues and expectations."
	icon = "Assets/Icons/Buildings/KnightlyTrainingGrounds.png:KnightlyTrainingGrounds#1"

	ai_category = "Military"
}

def Farrier : Upgrade
{
	name = "Farriers"
	flavor = "In the smithy, iron horseshoes are forged and fitted to the animals' hooves. Shoeing protects the hooves from wear and allows horses to endure long journeys over hard or rocky ground."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_Farrier.tga:UI_Structure_Icon_Farrier#2" //GUID:b4d952b7238f7e148a1858ffd314cfa9

	ai_category = "Military"
}

def SaddlersShop : Upgrade
{
	name = "Saddler's Workshop"
	flavor = "Saddlers craft saddles, bridles, and harnesses from leather and wood, carefully fitting them to each horse. Well-made tack allows riders to control their mounts securely, even in the chaos of battle."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_SaddlersShop.tga:UI_Structure_Icon_SaddlersShop#2" //GUID:d82e69dff50048049aec3441fb5eae73
}

def MessengerService : Upgrade
{
	name = "Messenger Service"
	flavor = "A relay network of horses and riders allows messages to travel swiftly across great distances. Fresh mounts are kept along important routes, allowing messengers to replace tired horses and continue their journey."
	icon = "Assets/Icons/Buildings/MessengerService.png:MessengerService#1"
}

def StudFarm : Upgrade
{
	name = "Stud Farm"
	flavor = "Selected mares and stallions are kept apart from ordinary livestock in dedicated breeding grounds. Spacious pastures and separate stables allow for careful rearing and the selection of valuable breeding stock."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_Horsemarket.tga:UI_Structure_Icon_Horsemarket#2" //GUID:5ea591ecbe4987b4497ab527b3458c10
}

def SelectiveBreeding : Upgrade
{
	name = "Selective Breeding"
	flavor = "Breeders select the strongest, most enduring, and most reliable animals for further breeding. Over generations, desirable traits can be reinforced, producing horses of increasingly valued qualities."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_WarStables.tga:UI_Structure_Icon_WarStables#2" //GUID:4614b122faea18e4582c4fdd671c9e5a

	ai_category = "Military"
	ai_eval = (base_ai_eval + 500)
}

def WarhorseBreed : Upgrade
{
	name = "Warhorse Breeds"
	flavor = "Particularly strong and spirited horses are bred and carefully raised for warfare. Breeding focuses on animals with the strength, endurance, and temperament needed to carry heavily armed riders into battle."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_WarhorseBreed.tga:UI_Structure_Icon_WarhorseBreed#2" //GUID:f1a9e3416c6845b42920bc3d197510e2
}

def MilitiaBarracks : Upgrade
{
	name = "Militia Barracks"
	flavor = "Dedicated quarters allow part of the militia to remain ready for service. The town can thus maintain bodies of armed citizens."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_TownWatch.tga:UI_Structure_Icon_TownWatch#2" //GUID:1a6e044b6de38554087fc06118a5bc99
	add_tooltip = "Required for recruiting {clr:enables_color}Militia Units{/clr}"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 1000)
}

def CrossbowManufactoring : Upgrade
{
	name = "Crossbow Manufactoring"
	flavor = "Workshops producing precise ranged weapons for trained watchmen and militias."
	icon = "Assets/Icons/Buildings/CrossbowManufactoring.png:CrossbowManufactoring#1"
	add_tooltip = "Required for recruiting {clr:enables_color}Crossbow Units{/clr}"

	ai_category = "Military"
	ai_eval = (kingdom.MilitiaBarracks and 1500)
}

def WindlassMechanisms : Upgrade
{
	name = "Windlass Mechanisms"
	flavor = "Development of a windlass cocking mechanism for crossbows that allows easier reloading and to put more weight into the shot."
	icon = "Assets/Icons/Buildings/CrossbowManufactoring.png:CrossbowManufactoring#1"
	add_tooltip = "Required for recruiting {clr:enables_color}Advanced Crossbow Units{/clr}"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 500)
}

def AdvancedBowmaking : Upgrade
{
	name = "Advanced Bowmaking"
	flavor = "Development of advanced bow-crafting techniques that enables the crafting of recourve or composite bows."
	icon = "Assets/Icons/Buildings/CrossbowManufactoring.png:CrossbowManufactoring#1"
	add_tooltip = "Required for recruiting {clr:enables_color}Advanced Bow Units{/clr}"

	ai_category = "Military"
	ai_eval = (base_ai_eval + 100)
}

def Watchtowers : Upgrade
{
	name = "Watchtowers"
	flavor = "Watchtowers are established along important roads, passes, and frontier lands. Their garrisons watch over the countryside, protect trade, and can report or delay enemy movements before they reach the heartland."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_WatchTowers.tga:UI_Structure_Icon_WatchTowers#2" //GUID:f0ab4cb600cc3c6449f4769c892d57bd
}

def WatchRotations : Upgrade
{
	name = "Watch Rotations"
	flavor = "A regular rotation of guards ensures that gates, streets, and vital facilities remain watched at all times. The militia can thus keep part of its strength on permanent duty even in peacetime."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_MountainPassGuards.tga:UI_Structure_Icon_MountainPassGuards#2" //GUID:4db8cfeb5d63bfa4b97e9b1232dab538

	ai_eval = (base_ai_eval + 250)
}

def HeraldryChambers : Upgrade
{
	name = "Heraldry Chambers"
	flavor = "Chambers where local heraldry like banners and coats of arms are stitched, woven and stored."
	icon = "Assets/Icons/Buildings/HeraldryChambers.png:HeraldryChambers#1"
}

def PlanningRoom : Upgrade
{
	name = "Planning Room"
	flavor = "This room is used incase the city comes under siege. It contains recruitment records, city maps and strategy guides."
	icon = "Assets/Icons/Buildings/PlanningRoom.png:PlanningRoom#1"
}

def RecruitmentOffices : Upgrade
{
	name = "Recruitment Offices"
	flavor = "Chambers to professionally organize the recruitment of levies troughout the province."
	icon = "Assets/Icons/Buildings/RecruitmentChambers.png:RecruitmentChambers#1"
}

def MercenaryHiringOffice : Upgrade
{
	name = "Mercenary Hiring Office"
	flavor = "Chambers to professionally organize the recruitment of mercenaries troughout kingdom."
	icon = "Assets/Icons/Buildings/MercenaryHiringOffice.png:MercenaryHiringOffice#1"

	ai_eval = (base_ai_eval + 250 + (If(kingdom.is_orthodox, 500, 0)))
}

def TrebuchetAssemblyYard : Upgrade
{
	name = "Trebuchet Assembly Yard"
	flavor = "Dedicated grounds equipped to construct massive counterweight trebuchets for long-range bombardment."
	icon = "Assets/Icons/Buildings/TrebuchetAssemblyYard.png:TrebuchetAssemblyYard#1"
	add_tooltip = "Enables constructing {clr:enables_color}trebuchets{/clr}"
}

def GunpowderStorage : Upgrade
{
	name = "Gunpowder Storage"
	flavor = "Secure magazines for storing volatile black powder, marking the dawn of explosive warfare."
	icon = "Assets/Icons/Buildings/GunpowderStorage.png:GunpowderStorage#1"
}

def CannonFoundry : Upgrade
{
	name = "Cannon Foundry"
	flavor = "Workshops casting early bronze or iron bombards, heralding the age of artillery."
	icon = "Assets/Icons/Buildings/CannonFoundry.png:CannonFoundry#1"
}

def DrillInstructors : Upgrade
{
	name = "Drill Instructors"
	flavor = "Veteran soldiers appointed to instill discipline and tactical precision in the ranks."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_TownWatch.tga:UI_Structure_Icon_TownWatch#2" //GUID:1a6e044b6de38554087fc06118a5bc99
}

def StandardizedArmament : Upgrade
{
	name = "Standardized Armament"
	flavor = "Uniform issue of weapons and armor, ensuring consistency and coordination among troops."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_ShoemakersShop.tga:UI_Structure_Icon_ShoemakersShop#2" //GUID:76d2b91679ac2fe4587cba83dc565d53
}

def OfficerMess : Upgrade
{
	name = "Officer Mess"
	flavor = "Dedicated quarters where officers plan, coordinate, and uphold military hierarchy and morale."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_MilitiaQuarter.tga:UI_Structure_Icon_MilitiaQuarter#2" //GUID:40a2bee7da8053144bb5cc07af4d59af
}

def InfantryFormations : Upgrade
{
	name = "Infantry Formations"
	flavor = "Advanced tactical training in tight formations, improving defense and cohesion on the battlefield."
	add_tooltip = "Required for recruiting {clr:enables_color}professional units{/clr}"

	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_CastleGuards.tga:UI_Structure_Icon_CastleGuards#2" //GUID:38c0caaaf283f9340b3e7b3ae563cef2
}

def CombinedArmsDoctrine : Upgrade
{
	name = "Combined Arms Doctrine"
	flavor = "Coordinated use of infantry, cavalry, and siege support, reflecting the evolution of medieval warfare into organized strategy."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_CastleGuards.tga:UI_Structure_Icon_CastleGuards#2" //GUID:38c0caaaf283f9340b3e7b3ae563cef2
}

// RELIGION

def ChurchPeace : Upgrade
{
	name = "Church Peace"
	flavor = "Establishing the Peace of God (Pax Dei) turns the consecrated ground within the churchyard walls into a weapons-free sanctuary. Under the protection of divine law, violence is strictly forbidden, transforming the courtyard into the safest and most bustling gathering point for community trade and local assembly."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_School.tga:UI_Structure_Icon_School#2" //GUID:20b12f2617600e5428a7f1129c8d2558
}

def Processions : Upgrade
{
	name = "Field Processions"
	flavor = "Religion moves beyond the stone walls. On holy days, the priest leads the entire congregation through the town borders and surrounding fields with banners and crosses. These sacred walks invoke divine protection to ward off evil spirits, pests, and blight, ensuring a bountiful harvest."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_Ceremonies_Christian.tga:UI_Structure_Icon_Ceremonies_Christian#2" //GUID:44b8eb3c5c9d4fe479f6c7d25fe0ceb7
}

def BellTower : Upgrade
{
	name = "Bell Tower"
	flavor = "Erecting a massive stone bell tower gives the town its temporal rhythm. The tolling bells replace the sun as the community's clock, dictating labor shifts and prayer hours, while its thunderous 'storm tolling' serves as a crucial early warning system against fires and oncoming sieges."
	icon = "Assets/Icons/Buildings/ProperBells.png:ProperBells#1"
	ai_eval = (base_ai_eval + 250)
}

def Cemetry : Upgrade
{
	name = "Cemetry"
	flavor = "The deceased are laid to rest in consecrated soil directly surrounding the parish church. In the Middle Ages, the cemetery is not a place of silent mourning, but a bustling hub of community life; since the dead are still considered part of the congregation, the living use this space for public assemblies, festivals, and daily social gatherings."
	icon = "Assets/Icons/Buildings/Cemetry.png:Cemetry#1"
}

def FrescoCycle : Upgrade
{
	name = "Fresco Cycle"
	flavor = "Since most townsfolk are illiterate, the church walls are covered from floor to ceiling with vibrant, hand-painted murals (Biblia Pauperum). Dramatic scenes of Christ’s life and the terrifying torments of the Last Judgment visually instruct the populace, instilling holy dread and loyalty to the faith."
	icon = "Assets/Icons/Buildings/Fresco.png:Fresco#1"
}

def Pulpit : Upgrade
{
	name = "Pulpit"
	flavor = "As the 13th century approaches, the priest steps off the altar and climbs onto an elevated pulpit in the nave. Speaking in the local dialect rather than Latin, he delivers moral guidance directly to the common folk, reinforcing social order and civic obedience."
	icon = "Assets/Icons/Buildings/Pulpit.png:Pulpit#1"
}

def HerbGrowing : Upgrade
{
	name = "Herb Growing"
	flavor = "Cultivation of medicinal plants for healing and apothecary use within and beyond the cloister walls."
	icon = "Assets/Icons/Buildings/HerbGrowing.png:HerbGrowing#1"
}

def Scriptorium : Upgrade
{
	name = "Scriptorium"
	flavor = "Quiet chambers where monks laboriously copy manuscripts, preserving sacred and classical texts alike."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_ScribesOffice.tga:UI_Structure_Icon_ScribesOffice#2" //GUID:ab3dc5b23bf99a640b72192498cf76f5

	ai_eval = (base_ai_eval + 1000)
}

def ScholaMonastica : Upgrade
{
	name = "Schola Monastica"
	flavor = "Schooling chambers where educated monks teach novices, noble and local children."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_School.tga:UI_Structure_Icon_School#2"

	ai_eval = (base_ai_eval + (map_clamp(game.time_hours, 0, 2, 0, 4000)))
}

def IlluminatorsAtelier : Upgrade
{
	name = "Illuminators’ Atelier"
	flavor = "Workshops producing richly decorated manuscripts that reflect divine beauty through art and color."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_ArtSchool.tga:UI_Structure_Icon_ArtSchool#2" //GUID:0f87d18486d8e2c44ac9fd51893ab403
}

def Hospital : Upgrade
{
	name = "Hospital"
	flavor = "Monastic infirmaries offering care to the sick and poor, guided by the ideals of charity and compassion."
	icon = "Assets/UI/Elements/Buildings/Icons/UI_Structure_Icon_Hospital.tga:UI_Structure_Icon_Hospital#2" //GUID:c654cc32eb9f489429550e17125c688c
}

def CistercianDiscipline : Upgrade
{
	name = "Cistercian Discipline"
	flavor = "Reform emphasizing manual labor, austerity, and self-sufficiency, spreading across Europe’s monastic world."
	icon = "Assets/Icons/Buildings/CistercianDiscipline.png:CistercianDiscipline#1"
}

def MoralTribunal : Upgrade
{
	name = "Moral Tribunal"
	flavor = "The court establishes a Sendgericht (synodal court), deploying local lay jurors to monitor the private lives of the citizens. Transgressions like gambling, drunkenness, adultery, or skipping Sunday mass are severely punished, often through public humiliation at the pillory."
	icon = "Assets/Icons/Buildings/MoralTribunal.png:MoralTribunal#1"
}

def InquisitorialChamber : Upgrade
{
	name = "Inquisitorial Chamber"
	flavor = "Beginning in the 1230s, the institutionalized Inquisition takes command. Specialized inquisitors (mostly Dominican friars) hunt down heretics and underground sects. The court now utilizes official pre-trial detention and 'painful interrogation' (torture) to extract confessions."
	icon = "Assets/Icons/Buildings/InquisitorialChamber.png:InquisitorialChamber#1"
}

def DiocesanAdministration : Upgrade
{
	name = "Diocesan Administration"
	flavor = "Offices coordinating tithes, appointments, and the management of Church lands across the region."
	icon = "Assets/Icons/Buildings/DiocesanAdministration.png:DiocesanAdministration#1"
}

def EpiscopalChancery : Upgrade
{
	name = "Consistory"
	flavor = "The bishop’s writing office, producing sealed documents, decrees, and correspondence for ecclesiastical affairs."
	icon = "Assets/Icons/Buildings/EpiscopalChancery.png:EpiscopalChancery#1"
}

def SynodalCourts : Upgrade
{
	name = "Synodal Courts"
	flavor = "Assemblies of clergy convened to deliberate on doctrine, discipline, and disputes within the diocesan realm."
	icon = "Assets/Icons/Buildings/SynodalCourts.png:SynodalCourts#1"
}

delete ChristianCeremonies
