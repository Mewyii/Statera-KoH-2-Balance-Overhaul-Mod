extend Settlement 
{
	garrison_squad_per_worker = 0.25
	garrison_worker_excess_manpower_bonus = 1

	attrition = [1,1,1]

	trade_center_gold_per_good = 0.5
	trade_center_gold_per_commerce = 0.25
}

extend Fortifications
{
	Resources cost = ["1g 1h", "500g 1500h", "1500g 3000h", "3000g 6000h"]
	int reqiured_citadel_level = [0,0,0,0] //[0,1,2,3]
	mod rs_siege_defense = 50/100/200/400
}

// Settlement numbers on map are also limited by settlements.def in /maps

Settlement.max_identical_settlement_per_realm = 3 // Limit for all settlements
Settlement.max_allowed_features_per_settlement_type = 5 // Features are not limited here anyways?
Settlement.max_specal_settlements_per_realm = 2
Settlement.min_restriction_settlements = 10
Settlement.max_restriction_settlements = 12
Settlement.settlement_repeating_chance_mul = 1.25 // relevant only for base settlements

RealmFeaturesPreset.preferred_min_distance = 1

extend Castle : Settlement
{
	no_governor_penalty = 25
	production = "2g 3f 1b 1p 8h 4WorkerSlots"

	delete enable_feature
	enable_feature
	{
		Grasslands
		Forests
		Swamps
		Desert
		AmberDeposits
		Pirates
		RareGame
		SaltDeposit
		SaltpeterDeposits
		SulfurDeposits
		SlaveTradersAfrica
		SlaveTradersRussia
		SpiceTraders
		Camels
		DyeExtraction
		IncenseCultivation
		AlumDeposits
		PilgrimageSiteChristian
		PilgrimageSiteMuslim
	}

	Worker.Gold = 1
}

extend Keep: Settlement
{
	production = "1Levy 1TownGuards"

	attrition = [5,5,5]
}

extend KeepEffects
{
	min_distance = 1
	max_distance = 30
}

extend Village
{
	production = "1g 1WorkerSlots 1TownGuards"

	color occupied_enemy = "255,0,0,94" //FF00005E
	color occupied_enemy_supporter = "120,0,0,150" //780000
	color occupied_ally = "25,125,0,170" //197d00
	color occupied_own = "48,255,0,94" //31FF005E
	color occupied_neutral = "99,153,190,120" //6399be
	prefab occupied_decal_prefab = "Assets/Europe/Prefabs/KeepOccupationDecal.prefab" //GUID:e2aadf3f574e5d84db4cfe475179171f
	
	float food_copy_mod = 0.5
	bool take_max_food = true
}

def SettlementsRandomizationWeights = 4 // Same settlement type limit for normal settlements
{
	float Village = 30
	float Farm = 30
    {
		float has_mountains = -15
	}
	float Monastery = 20
	float Keep = 20
    {
		float has_mountains = 20
	}
	float OasisVillage = 0
	float SteppeSettlement = 0
}

delete SpecialSettlementsRandomizationWeights
def SpecialSettlementsRandomizationWeights = 2 // Same settlement type limit for special settlements
{
    
    float Mine = 0
	{
		float has_mountains = 50
	}
	float Quarry = 40
    {
		float has_mountains = 20
	}
    float Vineyard = 25
	float HorseFarm = 8
}

extend Quarry
{
	production = "1g 1h"

	delete enable_feature
	enable_feature
	{
		default LimestoneDeposit
		secondary MarbleDeposit
	}
}

extend Mine
{
	production = "1g 1Trade"

	delete enable_feature
	enable_feature
	{
		default IronOre
		secondary GoldOre
		secondary SilverOre
		secondary GemstoneDeposits
	}
}

extend CattleFarm
{
	production = "1f 1Trade"
}

extend SheepFarm
{
	production = "2f"
}

extend HorseFarm
{
	production = "1g 1Trade"
}

extend Vineyard
{
	production = "1f 1g"
}

def OasisVillage : Settlement
{
	name = "Oasis"
	{
		multiple = "Oasis"
	}
	
	description = $["An Oasis is an area in a desert that provides water, food and shelter."]
	
	enable_feature
	{
		default Oasis
	}
	
	production = "1f 1TownGuards"
	
	icon = "Assets/Icons/Features/Oasis.png:Oasis#1"
	illustration = "Assets/Icons/Features/Oasis.png:Oasis#1"
	selection_sound = "event:/sound_effects/interaction/select/settlement/flax_field"
	max_identical_settlement_per_realm = 2
	
	radius = 6

	ai_eval_food = 1
	ai_eval_trade = 2
}

def SteppeSettlement : Settlement
{
	name = "Steppe"
	{
		multiple = "Steppes"
	}
	
	description = $["A vast, dry, grassy semi-arid plain."]
	
	enable_feature
	{
		default Steppe
	}
	
	production = "1f 1Levy"
	
	icon = "Assets/Icons/Features/Steppe.png:Steppe#1"
	illustration = "Assets/Icons/Features/Steppe.png:Steppe#1"
	selection_sound = "event:/sound_effects/interaction/select/settlement/flax_field"
	max_identical_settlement_per_realm = 3
	
	radius = 6

	ai_eval_food = 1
	ai_eval_military = 1
}
