def Fortifications
{
	Resources cost = ["1g 1h", "300g 200 Levy 1000h", "900g 400 Levy 2500h", "2000g 1000 Levy 6000h"]
	int reqiured_citadel_level = [0,0,0,0] //[0,1,2,3]
	mod rs_siege_defense = 0/50/150/300
}

// Settlement numbers on map are also limited by settlements.def in /maps

Settlement.max_identical_settlement_per_realm = 3 // Limit for all settlements
Settlement.max_allowed_features_per_settlement_type = 3 // Features are not limited here anyways?
Settlement.max_specal_settlements_per_realm = 3
Settlement.min_restriction_settlements = 8
Settlement.max_restriction_settlements = 12
Settlement.settlement_repeating_chance_mul = 1.4 // relevant only for base settlements

def Castle : Settlement
{
	no_governor_penalty = 25
	production = "2g 3f 1b 1p 8h 4WorkerSlots"

	enable_feature
	{
		AmberDeposits
		Camels
		MineralsDeposit
		Pirates
		RareGame
		SaltDeposit
		SaltpeterDeposits
		SulfurDeposits
		SlaveTradersAfrica
		SlaveTradersRussia
		SpiceTraders
	}

	Worker.Gold = 1
}

extend KeepEffects
{
	min_distance = 1
	max_distance = 25
}

def SettlementsRandomizationWeights = 3 // Same settlement type limit for normal settlements
{
	float Village = 30
	float Farm = 30
    {
		float has_mountains = -15
	}
	float Monastery = 20
	float Keep = 20
    {
		float has_mountains = 20
	}
}

delete SpecialSettlementsRandomizationWeights
def SpecialSettlementsRandomizationWeights = 2 // Same settlement type limit for special settlements
{
    float LoggingCamp = 50
    {
		float has_mountains = -15
	}
    float Mine = 0
	{
		float has_mountains = 60
	}
	float Quarry = 25
    {
		float has_mountains = 10
	}
    float SheepFarm = 20
	float CattleFarm = 20
    float Vineyard = 15
	float HorseFarm = 15
	float OasisVillage = 50
	float SteppeSettlement = 50
}

Mine.max_allowed_features_per_settlement_type = 3
def Quarry : Settlement
{
	enable_feature
	{
		default LimestoneDeposit
		secondary MarbleDeposit
	}
}




def OasisVillage : Settlement
{
	name = "Oasis"
	{
		multiple = "Oasis"
	}
	
	description = $["An Oasis is an area in a desert that provides water, food and shelter."]
	
	enable_feature
	{
		default Oasis
	}
	
	production = "1f"
	
	icon = "Assets/Icons/Features/Oasis.png:Oasis#1"
	illustration = "Assets/Icons/Features/Oasis.png:Oasis#1"
	selection_sound = "event:/sound_effects/interaction/select/settlement/flax_field"
	max_identical_settlement_per_realm = 2
	
	radius = 6

	ai_eval_food = 1
	ai_eval_trade = 2
}

def Oasis : ProvinceFeature
{
	name = "Oasis"
	flavor = "Oasis description."
	tooltip = "An Oasis is an area in a desert that provides water, food and shelter."
	icon = "Assets/Icons/Features/Oasis.png:Oasis#1"
	icon_big = "Assets/Icons/Features/Oasis.png:Oasis#1"
	
	area = [0.125, 0, 0.95, 0.175]
	spawn_chance = 100
	special = true
}

def SteppeSettlement : Settlement
{
	name = "Steppe"
	{
		multiple = "Steppes"
	}
	
	description = $["A vast, dry, grassy semi-arid plain."]
	
	enable_feature
	{
		default Steppe
	}
	
	production = "1f 1Levy"
	
	icon = "Assets/Icons/Features/Steppe.png:Steppe#1"
	illustration = "Assets/Icons/Features/Steppe.png:Steppe#1"
	selection_sound = "event:/sound_effects/interaction/select/settlement/flax_field"
	max_identical_settlement_per_realm = 3
	
	radius = 6

	ai_eval_food = 1
	ai_eval_military = 1
}

def Steppe : ProvinceFeature
{
	name = "Steppe"
	flavor = "Steppe description."
	tooltip = "A vast, dry, grassy semi-arid plain."
	icon = "Assets/Icons/Features/Steppe.png:Steppe#1"
	icon_big = "Assets/Icons/Features/Steppe.png:Steppe#1"
	
	area = [0.66, 0.5, 1, 0.68]
	spawn_chance = 100
	special = true
}

def SlaveTradersAfrica : ProvinceFeature
{
	name = "Slave Traders (Africa)"
	flavor = "Slave Traders description."
	tooltip = "Slave traders can be used to hunt and trade slaves in nearby provinces. Slaves might be used as soldiers, workers or servants."
	icon = "Assets/Icons/Features/SlaveTraders.png:SlaveTraders#1"
	icon_big = "Assets/Icons/Features/SlaveTraders.png:SlaveTraders#1"
	
	area = [0, 0, 0.9, 0.25]
	spawn_chance = 5
}

