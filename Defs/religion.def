Catholic.ask_crusade_funds_cooldown = 150/300

def Crusade
{
	
	float cooldown = 1200 // cooldown of the crusade action
	float cooldown_for_players = 600 // cooldown of the crusade action through audience
	float initial_cooldown_crusade = 1500 //cooldown after the game starts
	
	float minTroopsOnGoHome = 2
	float maxTroopsOnGoHome = 5
	float skillCopyPercentage = 70
	float crusadeNumKingdoms = 3
	float crusadePlayerKingdomsPerc = 30
	float sackGoldMultiplier = 50
	
	int max_peasants = 5 //num guaranteed peasant squads in the army, reduced by 1 for each hour ingame time
	
	int supplies_consumption_rate_mod = 0.1
	
	bool crusader_kingdom_is_hostile = (src_kingdom.IsEnemy(plr_kingdom))
	bool pope_kingdom_is_hostile = (pope.original_kingdom != papacy && pope.original_kingdom.IsEnemy(plr_kingdom))
	bool papacy_is_hostile = (papacy.IsEnemy(plr_kingdom))
	bool crusade_is_hostile_and_we_are_not_involved = ((crusader_kingdom_is_hostile || pope_kingdom_is_hostile || papacy_is_hostile) && target != plr_kingdom && leader.kingdom != plr_kingdom && pope.original_kingdom != plr_kingdom)
	text crusade_flavor_non_target = "Since we are at war against [{crusader_kingdom_is_hostile:if}{leader:s} kingdom ({src_kingdom})|{pope_kingdom_is_hostile:if}{pope:s} kingdom of origin ({pope.original_kingdom})|{papacy_is_hostile:if}{papacy}], the crusaders might attack our towns and armies."
	text fundsValue = "{wealth}{gold_icon}"
	
	int giveToKingdomMaxDistance = 2
	capture_realm_outcomes
	{
		main give_to_kingdom = 100
		{
			upScaleOptions = true //scale to sum(chances) instead to 100, to prevent no outcomes.
			
			option give_to_leader_kingdom = 30
			{
				king = 90
				prince = 50
			}
			option give_to_papacy = 30
			option give_to_helping_kingdom = 30
			option give_to_established_kingdom = 10
		}
		option establish_new_kingdom //happens when it cant be given to any kingdom
		{
			upScaleOptions = true
			main give_to_leader_kingdom_ignore_checks = 0
			{
				cant_establish_new_kingdom = 100
			}
			option independent = 0
			{
				leader_and_papacy_are_vassals_of_ther_kingdoms = 100
			}
			option vasal_of_leader_kingdom = 60
			{
				king = 100
				prince = 80
			}
			option vasal_of_papacy = 40
		}
	}
	
	end_crusade_outcomes
	{
		main return = 50
		{
			crusade_successful = 100
			leader_kingdom_destroyed = 100
			papacy_destroyed = 0
			king = 100
			prince = 75
		}
		option rogue
		option default // prevent "no outcome"
	}
	
	crusader_death_outcomes
	{
		main army_goes_rogue = 70
		option army_becomes_merc_camp = 30
		option default // prevent "no outcome"
	}
	
	crusader_exiled_outcomes
	{
		main army_becomes_merc_camp = 100
		option default // prevent "no outcome"
	}
}



//Religion Factors
def Catholic : Christian
{
    mod ks_prod_piety_flat = 5
    mod ks_population_growth_perc = 10
    mod ks_base_gold_income = 5
    mod ks_prod_books_religion = -5

    religious_tension
	{
		float Catholic = 0
		float Orthodox = 5
		float Sunni = 15
		float Shia = 15
		float Pagan = 10
		float Jewish = 10
	}
}

def Orthodox : Christian
{
    mod ks_base_gold_income = 10
    mod ks_hammers_in_provinces_perc = 10
    mod ks_max_population = 3
    mod ks_culture = -10

    religious_tension
	{
		float Catholic = 5
		float Orthodox = 0
		float Sunni = 10
		float Shia = 10
		float Pagan = 5
		float Jewish = 5
	}
}

def Pagan : Religion
{
    mod ks_happiness = 2
    mod ks_army_morale = 2
    mod ks_commerce_religion = 5
    mod ks_base_levy_income = -5

    religious_tension
	{
		float Catholic = 10
		float Orthodox = 5
		float Sunni = 10
		float Shia = 10
		float Pagan = 0
		float Jewish = 5
	}
}

def Shia : Muslim
{
    mod ks_prod_books_religion = 5
    mod ks_base_gold_income = 5
    mod ks_hammers_in_provinces_perc = 5
    mod ks_corruption = 5

    religious_tension
	{
		float Catholic = 15
		float Orthodox = 10
		float Sunni = 5
		float Shia = 0
		float Pagan = 5
		float Jewish = 10
	}
}

def Sunni : Muslim
{
    mod ks_prod_piety_flat = 5
    mod ks_hammers_in_provinces_perc = 5
    mod ks_max_population = 3
    mod ks_corruption = 5

    religious_tension
	{
		float Catholic = 15
		float Orthodox = 10
		float Sunni = 5
		float Shia = 0
		float Pagan = 10
		float Jewish = 10
	}
}

