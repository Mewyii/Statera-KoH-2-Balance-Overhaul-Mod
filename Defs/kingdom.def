extend Kingdom {
    tax_rates = 30
    royal_court_slots = 9
    wage_thresholds = [5, 20, 50, 100, 200, 300, 400, 500]
    trade_route_profit_exclusive_mod = 1.1
    trade_route_profit_relation_mod = 1.2
    trade_route_capacity_mod = 0.25

    resources starting_resources
	{
		gold = (1000 + (120 * (num_realms -1)))
		books = (300 + (20 * (num_realms -1)))
		levy = (200 + (20 * (num_realms -1)))
		piety = (300 + (20 * (num_realms -1)))
	}

    // % from max treasury, used to calculate possible gold amounts in diplomatic negotiations, i.e. S1 .. S5
	diplomatic_gold_perc = 10/20/40/60/80

	mp_levies_weight = 1

	min_provinces_hunger_stability_penalty_perc = 25

	traditions_slots = ["All","All","All","All","All","All","All","All","All"]
	traditions_slots_tiers = [0,1,1,2,2,2,3,3,3]
}




extend Tradition {
    float per_adopted_cost_gold = 0
	float per_adopted_cost_books = 0
    float per_adopted_cost_piety = 0

	float tier_cost_gold = [500,750,1000,1250]
	float tier_cost_books = [500,750,1000,1250]
	float tier_cost_piety = [500,750,1000,1250]

    float kingdom_size_modifier = (1 + (0.05 * (kingdom.realms_count - 1)))

    resources adopt_cost
	{
		gold = (round((tier_cost_gold[tier] * kingdom_size_modifier)))
		books = (round((tier_cost_books[tier] * kingdom_size_modifier)))
        piety = (round((tier_cost_piety[tier] * kingdom_size_modifier)))
	}
}

extend CrownAuthority {
    corruptionMods = [20, 16, 12, 8, 4, 0, -2, -4, -6, -8, -10]

    // Sadly kingdom size modifier doesnt work here. kingdom, own_kingdom or num_realms dont work
    requirementGoldBaseAmounts = [75, 100, 125, 150, 175, 200, 225, 250, 275, 300]
    requirementPietyAmounts = [500, 550, 600, 650, 700, 800, 900, 1000, 1100, 1250]

    float ca_positive_stability_multiplier = 1.5
	float ca_negative_stability_multiplier = 1.5
	
    // Positive
    int stopped_crusade_against_us = 1
	int warWon = 1
	int payGold = 1

	// Neutral
    int change_heir = 0
	int vassalGet = 0
	int execute_rebel = 0
    int knightDesertion = 0
	int breakTrade = 0

    // Negative
    int kingDeath = -3
	int noSuccessor = -1
	int establish_order = -1
	int realm_annex = -1
	int rebelOccupation = -1
	int religionChangeSuccess = -1
	int religionChangeFail = -1
    int warLost = -1
    int vassalBecome = -1
	int breakNAP = -2
	int breakAlliance = -2

    
	
	// TODO
	int DeclinedVassalDefend = -1
	int stopPromotingPaganBelief = -1
	int denounced_rebel = -1
	int denounced_famous_rebel = -2
	int torture = 0 // this should have heavy relations drop
	int executePrisoner = -1
	int ChangePaganTraditionsActionFail = -2
	int AutocephalyActionFail = -3
	int ClaimCaliphateActionSuccess = 3
	int ClaimCaliphateActionFail = -3
	int AbandonCaliphateActionSuccess = -3
	int claimThroneFail = -5 // placeholder (if vote for emperor of the world was failed)
	int restorationQuestCompleted = 3 // Placeholder
	int uniteQuestCompleted = 5 // Placeholder
	int failed_spawn_loyalist = -1 //obsolete - we might want to use this later?
	
	int reject_being_emperor_of_the_world = -5
	int reject_ai_emperor_of_the_world = -5 //SP only
	int pretender_emperor_of_the_world = -5
	int end_jihad = -1
	
	int release_non_court_rebel = -1
	int forgive_court_rebel = (round(map(target.class_level, 0, 15, -1, -3)))
	
	int bankruptcy = -3
	int ClaimIndependenceFail = -1
}

extend WarExhaustionModifier : FadingModifier
{
	min = 0;
	max = 100;
	time_period_increase = 90;
	increase_base = 1;
	increase_per_war = 0.25;
	time_period_decrease = 30;
	decrease_base = 1;
}