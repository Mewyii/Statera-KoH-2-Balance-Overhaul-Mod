	{
		pc_they_rule_our_people { our_kingdom = 10; our_culture = 5; our_culture_family = 2; max = 30 } //we are not done with them
		pc_they_rule_our_lands	{ per_historical_realm = 5; per_core_realm = 5;	max = 30 }
