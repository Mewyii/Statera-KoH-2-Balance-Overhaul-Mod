def DevSettings
{
	float ai_jihad_upkeep_mult = 0.1
	
	//-1: use default 
	// 0: none
	// 1: statistics and logging; (e.g. dump game stats); advanced camera controls
	// 2: dev tooltips, debug views, high-impact commands (e.g. conquer kingdom)
	// 3: low-level manipulations (e.g. kill character)
	int cheat_level = 0
	
	//////////////////////////////////////////////////////////////////////////
	///////////////////// DIFFICULTY SETTINGS  ///////////////////////////////
	//////////////////////////////////////////////////////////////////////////
	// values are per difficulty: <easy>/<normal>/<hard>/<very_hard>
	float ai_resource_boost = 1.0 / 1.2 / 1.5 / 1.8
	{
		gold = 1.2 / 1.4 / 1.6 / 2.0
		books = 1.1 / 1.2 / 1.3 / 1.4
		piety = 1.1 / 1.2 / 1.3 / 1.4
		food = 1.1 / 1.2 / 1.3 / 1.4
		levy = 1.1 / 1.2 / 1.3 / 1.4
	}

	float min_rebel_pop_time = 30 / 15 / 5 / 0 // in minutes, depending on difficulty settings

	int max_player_initial_wars = 0 / 0 / 1 / 1

	int max_player_rebellions = 1/3/5/8
	int max_rebels_per_player_kingdom = 5/15/20/30

	// This is about what gets written in audio.log.
	// It does not concern Debug.Log, do not turn it off in release builds.
	// 0: Nothing
	// 1: Error
	// 2: Warning (incl. previous)
	// 3: Info (incl. previous)
	int audio_log_level = 1
}

extend AI 
{
	// used to calculate "production score" for a building / upgrade
	province_specialization_resource_weights
	{
		resources General
		{
			Gold = 100
			Food = 50
			Books = 500
			Piety = 250
			Levy = 100
			TownGuards = 50
			WorkerSlots = 100
			Trade = 50
			Goods = 100
			UniqueGoods = 5000
		}

		resources Military : General
		{
			Levy = 500
		}

		resources Gold : General
		{
			Gold = 200
			Food = 50
			Trade = 50
			Books = 50
			Piety = 50
			Levy = 50
			TownGuards = 50
			WorkerSlots = 50
		}

		resources Food : General
		{
			Food = 1000			
			Gold = 50
			Books = 50
			Piety = 50
			Levy = 50
			TownGuards = 50
			WorkerSlots = 50
			Trade = 25
		}

		resources Religion : General
		{
			Books = 1000
			Piety = 500
			Gold = 50
			Food = 50
			Levy = 50
			TownGuards = 50
			WorkerSlots = 50
			Trade = 25
		}

		//resources Trade
		//resources Crafts

		resources GeneralSpec : General
		{
			Gold = 225
			Food = 50
			Books = 500
			Piety = 250
			Levy = 100
			TownGuards = 50
			WorkerSlots = 100
			Trade = 50
			Goods = 100
			UniqueGoods = 5000
		}

		resources MilitarySpec : General
		{
			Gold = 125
			Food = 100
			Books = 250
			Piety = 100
			Levy = 500
			//TownGuards
			WorkerSlots = 500
			Trade = 50
			Goods = 50
			//UniqueGoods
		}

		resources TradeSpec : General
		{
			Gold = 350
			//Food
			Books = 250
			Piety = 100
			Levy = 50
			//TownGuards
			//WorkerSlots
			Trade = 400
			Goods = 250
			//UniqueGoods
		}

		resources FoodSpec : General
		{		
			Gold = 125
			Food = 600	
			Books = 250
			Piety = 100
			Levy = 50
			//TownGuards
			//WorkerSlots
			Trade = 50
			Goods = 50
			//UniqueGoods
		}

		resources ReligionSpec : General
		{
			Gold = 125
			//Food
			Books = 800
			Piety = 600
			Levy = 50
			//TownGuards
			WorkerSlots = 50
			Trade = 50
			Goods = 50
			//UniqueGoods
		}
	}

	non_governed_production_eval_mul = 0.25

	// per number of buildings built, value is immediate / near future / far future
	// immediate: "production score" we will get immediatelly
	// near_future: plus everything that can be built/upgraded at the moment
	// far_future: when fully built and upgraded
	production_evaluation_future_weights 
	{
		0 = 1.0 / 0.8 / 0.3
		2 = 1.0 / 0.8 / 0.3
		4 = 1.0 / 0.8 / 0.25
		6 = 0.9 / 0.7 / 0.25
		8 = 0.9 / 0.7 / 0.2
		10 = 0.9 / 0.7 / 0.2
		12 = 0.8 / 0.6 / 0.15
		14 = 0.8 / 0.6 / 0.15
	}

	// maximum percentage of gold earned to spend on specific category
	budget
	{
		None = (map_clamp(game.time_hours, 0, 4, 0, 20)) // reserves
		Military = (15 + (king_warfare_ability * 1.5) + min(num_wars, 1) * 20)
		Economy = (60 + (king_economy_ability * 1.5) - min(num_wars, 1) * 20)
		Diplomacy = (2 + (king_diplomacy_ability * 1.5) - min(num_wars, 1) * 5)
		Espionage = (1 + (king_espionage_ability * 1.5) + min(num_wars, 1) * 5)
		Religion = (3 + (king_religion_ability * 1.5))
	}

	// maximum percentage of income allowed for upkeeps
	// subcategories are taken from IncomePanels.def
	// for subcategories both the subcategory and the parent category must be OK
	// total is also always checked, as if it was the parent of everything
	upkeeps_budget
	{
		None = (map_clamp(game.time_hours, 0, 4, 20, 35) + min(num_wars, 1) * 20) // total
		Military = (10 + (king_warfare_ability * 1.5) + min(num_wars, 1) * 15)
		{
			ArmyUpkeep = (10 + (king_warfare_ability * 1.5) + min(num_wars, 1) * 15)
		}
		Economy = (3 + (king_economy_ability * 1.5))
		Diplomacy = (3 + (king_diplomacy_ability * 1.5))
		Espionage = (3 + (king_espionage_ability * 1.5) + min(num_wars, 1) * 5)
		{
			Bribes = (3 + (king_espionage_ability * 1.5))
		}
		Religion = (3 + (king_religion_ability * 1.5) + is_pagan * 5)
		{
			subtotal = "Religion_Culture"
		}
	}	

	BigBonusPower = 3;
	BonusPower = 1.25;
	MalusPower = 1.0;

	// big bonus for offmap empires
	delete big_bonus_eligible_kingdoms
	big_bonus_eligible_kingdoms { Kipchak; Golden_Horde; }

	// bonus for historically important kingdoms
	delete bonus_eligible_kingdoms
	bonus_eligible_kingdoms { England; Scotland; France; Castile; Portgual; Aragon; Germany; Bohemia; Sweden; Denmark; Poland; Lithuania; Hungary; Venice; Genoa; SicilyNorman; Sicily; Byzantium; Kyiv; Novgorod; Volga_Bulgaria; Toksoba; Kipchak; Georgia; Rum; Abbasids; Seljuks; Kerman; Assassin_Order; Jerusalem; Fatimids; Kanem; Almoravids; Nicaea; Mongols; Ottomans; Austria; Muscovy; Mali; Mamluks; }
	// malus are all the others

	// used to calculate "production score" for a building / upgrade
	province_specialization_resource_weights
	{
		food_reserve = 8
	{
		critical_weight = 10000  // alter food weight if bellow 0
		low_weight = 200        // alter food weight if bellow reserve
	}
	}
}
