		pc_we_have_war_exhaustion {	max = 100 }
		pc_we_have_too_many_wars { max = 100; at_war_base = 40; per_additional_war = 40 }
		pc_we_have_too_many_captured_knights {per_prisoner = 5; minimum_prisoners = 0;	max = 30}
		pc_too_many_global_wars { max = 40; num_wars = 40 }
		pc_our_authority_is_low { per_negative_point = 15 }
		pc_their_diplomat_skill_level { base = 10; max = 50 }
		pc_we_are_papacy = 40
