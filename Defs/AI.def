		pc_they_have_too_many_wars { at_war_base = 10; per_additional_war = 20; max = 50 }
		pc_they_are_too_far = 20 { threshold = 3 }
		pc_they_have_war_exhaustion	{ max = 10 }
		pc_we_have_right_to_expand { max = 0; time = 1200 } // disabling
		pc_we_are_X_times_larger = 20 {	X = 1 ; added_realms = 2}
		pc_our_liege_have_many_vassals = (If(target_kingdom.is_player, map_clamp(thier_kingdom.num_vassals, 2, 6, 0, pdv(10,20,30,40)), 0))
		pc_we_have_too_many_captured_knights {per_prisoner = 5; minimum_prisoners = 0;	max = 30}
	} 

