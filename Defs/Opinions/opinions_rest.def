def WeWereUnexcommunicatedClergyOpinionRule : OpinionChangeRule
{
	opinion = "ClergyOpinion"
	amount = 5
	reason = "unexcommunicated"
	
	switch_value = (st_sender.religion.head.is_dead)
	case 1
	{
		flavor = ["With the fall of Rome, our {st_sender.kingdom.KingdomType} is no longer excommunicated. Thus, our clergy rejoices, as the stigma over our people has been lifted once and for all.",
		"Our clergymen mourn the fall of Rome, yet they seem to have forgiven their {st_sender.kingdom.king.title} for allowing our {st_sender.kingdom.KingdomType} to be excommunicated in the first place."]
	}
	case default
	{
		flavor = "By convincing {pope} to lift the stigma of excommunication over our {st_sender.kingdom.KingdomType}, {st_sender.king} showed our clergy that he is a holy man acting under the guidance of God."
	}

	triggers
	{
		kingdom unexcommunicated
		{
			condition = (sender.is_catholic)
		}
	}
}

