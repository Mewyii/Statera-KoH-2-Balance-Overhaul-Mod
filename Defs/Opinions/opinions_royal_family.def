def HoldAFeastArmyOpinionRule : OpinionChangeRule
{
	opinion = "ArmyOpinion"
	amount = 1
	reason = "hold_feast_army"
	// Vary this a bit
	flavor = "The army greatly enjoyed the generous feast {kingdom.king} organized recently and still praise the ale and mead."
	
	triggers = 80
	{
		kingdom hold_feast
	}
}

// MARRIAGE

def MarriageNobilityOpinionRule : OpinionChangeRule
{
	opinion = "NobilityOpinion"
	var opinion_change = ((sender.culture_group == param.spouse.kingdom_before_marriage.culture_group) && 2 || -1)
	amount = (opinion_change)
	reason = "marriage_nobility"
	
	case same_culture = (opinion_change > 0)
	{
		flavor = "Our nobility rejoices at the news that {kingdom.king} has found a suitable bride, and hope that the union will bring unity and prosperity to the realm."
	}
	case different_culture = (opinion_change < 0)
	{
		flavor = "Our nobility is troubled by the news that {kingdom.king} has married a foreigner with a different culture. They are concerned about the potential consequences."
	}
	
	triggers
	{
		kingdom character_married
	}
}

def MarriagePeasantryOpinionRule : OpinionChangeRule
{
	opinion = "PeasantryOpinion"
	var opinion_change = ((sender.culture_group == param.spouse.kingdom_before_marriage.culture_group) && 1 || -2)
	amount = (opinion_change)
	reason = "marriage_peasantry"

	case same_culture = (opinion_change > 0)
	{
		flavor = "Our common folk rejoice at the news that {kingdom.king} has found a suitable bride, and hope that the union will bring peace and prosperity to the realm."
	}
	case different_culture = (opinion_change < 0)
	{
		flavor = "Our common folk are troubled by the news that {kingdom.king} has married a foreigner with a vastly different culture. They don't think this is a wise decision and are concerned about the potential consequences."
	}
	
	triggers
	{
		kingdom character_married
		{
		}
	}
}

def MarriageClergyOpinionRule : OpinionChangeRule
{
	opinion = "ClergyOpinion"
	var opinion_change = ((sender.religion != param.spouse.kingdom_before_marriage.religion) && 1 || -2)
	amount = (opinion_change)
	reason = "marriage_clergy"

	case same_religion = (opinion_change > 0)
	{
		flavor = "Forming a royal marriage with {st_param.spouse.kingdom_before_marriage} was seen by many as a wise and pious move. The clergy is pleased that our {king} has chosen a spouse who shares our faith."
	}
	case different_religion = (opinion_change < 0)
	{
		flavor = "Forming a royal marriage with {st_param.spouse.kingdom_before_marriage} was seen by many as an ill-advised move. The clergy is concerned that our {king} has chosen a spouse who does not share our faith."
	}
	
	triggers
	{
		kingdom character_married
		{
		}
	}
}
