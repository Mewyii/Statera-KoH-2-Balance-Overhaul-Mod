	flavor = "Our merchants greatly enjoyed the generous feast {kingdom.king} organized recently and still praise the trading opportunities it provided."
	
	triggers = 80
	{
		kingdom hold_feast
	}
}

def HoldAFeastClergyOpinionRule : OpinionChangeRule
{
	opinion = "ClergyOpinion"
	amount = 1
	reason = "hold_feast_clergy"
	flavor = "Our clergy appreciated the generous feast {kingdom.king} organized recently and still praise the royal cooks and pious ceremonies."
	
	triggers = 80
	{
		kingdom hold_feast
	}
